{%- assign has_addons = false -%}
{%- for addon_check in cart.items -%}
  {%- if addon_check.properties.parent_key == item.key -%}
    {%- assign has_addons = true -%}
  {%- endif -%}
{%- endfor -%}

{%- assign is_addon = false -%}
{%- if item.properties.is_addon == 'true' -%}
  {%- assign is_addon = true -%}
{%- endif -%}

<div
  class="py-4 flex flex-col sm:flex-row sm:space-x-4 border-b border-grey"
  data-has-addons="{{ has_addons }}"
>
  <!-- Product image column -->
  {% if item.image %}
    <a href="{{ item.url }}" class="size-28 flex-shrink-0 inline-block">
      <img
        src="{{ item.image | img_url: '600x' }}"
        alt="{{ item.title }}"
        class="size-28 object-contain border border-grey p-2 rounded"
        width="80"
        height="80"
      >
    </a>
  {% else %}
    <div class="size-28 bg-gray-100 rounded flex-shrink-0"></div>
  {% endif %}

  <div class="flex-1 ml-3 max-w-3xs">
    <div class="text-sm font-semibold">
      <a href="{{ item.url }}" class="hover:underline">{{ item.title }}</a>
    </div>

    {%- assign show_options = false -%}
    {%- if item.options_with_values -%}
      {%- for opt in item.options_with_values -%}
        {%- if opt.value and opt.value != 'Default Title' -%}
          {%- assign show_options = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
 {%- if item.product.type == 'Custom Signs' -%}
        {%- assign show_options = false -%}
      {%- endif -%}
    {%- if show_options -%}
      <div class="text-sm text-gray-600">
        {%- for opt in item.options_with_values -%}
          <span class="block">{{ opt.name }}: {{ opt.value }}</span>
        {%- endfor -%}
      </div>
    {%- elsif item.variant.title != 'Default Title' -%}
      <div class="text-sm text-gray-600">{{ item.variant.title }}</div>
    {%- endif -%}
    <div class="text-sm text-gray-600">{% render 'cart-line-property', item: item %}</div>
    {% if has_addons %}
      <div class="mt-2">
        <button
          type="button"
          class="view-fixings-btn text-xs text-gray-600 flex items-center gap-1 underline"
          data-parent-key="{{ item.key }}"
        >
          <span>View Fixings</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 view-fixings-icon transition-transform duration-200"
          >
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
        <div
          class="fixings-panel overflow-hidden mt-2"
          data-parent-key="{{ item.key }}"
          style="max-height:0; transition:max-height 300ms ease;"
        >
          {% render 'cart-fixing-list', parent_key: item.key %}
        </div>
      </div>
    {% endif %}
    <!-- Price -->
    <div class="text-sm mt-2">
      {{ item.price | money }}
      {% if item.discounts[0].title %}
        <div class="text-xs text-bg-light-red flex mt-1">
          <div class="flex gap-1 items-center">
            {% render 'icon-svg-tag', class: 'size-3' -%}
            <span class="uppercase">{{- item.discounts[0].title }}</span>
          </div>
        </div>
      {% elsif customer %}
        {%- assign customer_tags_lower = customer.tags | join: ',' | downcase -%}
        {%- if customer_tags_lower contains 'b2b' -%}
          {%- assign b2b_raw = item.product.metafields.custom.b2b_tiered_discounts_qty | default: '' | strip -%}
          {%- if b2b_raw != '' -%}
            {%- assign b2b_matched_pct = '' -%}
            {%- assign b2b_entries = b2b_raw | split: ',' -%}
            {%- for b2b_entry in b2b_entries -%}
              {%- assign b2b_parts = b2b_entry | strip | split: '|' -%}
              {%- if b2b_parts.size >= 3 -%}
                {%- assign b2b_range = b2b_parts[1] | strip | replace: ' ', '' -%}
                {%- assign b2b_pct = b2b_parts[2] | strip | replace: ' ', '' -%}
                {%- assign b2b_range_parts = b2b_range | split: '-' -%}
                {%- assign b2b_min = b2b_range_parts[0] | times: 1 -%}
                {%- assign b2b_max_str = b2b_range_parts[1] | default: '' -%}
                {%- if b2b_max_str == '' or b2b_max_str contains '999' -%}
                  {%- if item.quantity >= b2b_min -%}{%- assign b2b_matched_pct = b2b_pct -%}{%- endif -%}
                {%- else -%}
                  {%- assign b2b_max = b2b_max_str | times: 1 -%}
                  {%- if item.quantity >= b2b_min and item.quantity <= b2b_max -%}{%- assign b2b_matched_pct = b2b_pct -%}{%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if b2b_matched_pct != '' -%}
              {%- unless b2b_matched_pct contains '%' -%}{%- assign b2b_matched_pct = b2b_matched_pct | append: '%' -%}{%- endunless -%}
              <div class="text-xs text-bg-light-red flex mt-1">
                <div class="flex gap-1 items-center">
                  {% render 'icon-svg-tag', class: 'size-3' %}
                  <span class="uppercase">B2B {{ b2b_matched_pct }} OFF</span>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {% endif %}
    </div>
    <!-- Quantity -->
    <div class="mt-2 flex items-center space-x-2">
      {%- assign is_custom_cut = false -%}
      {%- for p in item.properties -%}
        {%- assign prop_key = p.first | downcase -%}
        {%- if prop_key contains 'custom cut' -%}
          {%- assign is_custom_cut = true -%}
        {%- endif -%}
      {%- endfor -%}
      {% if is_custom_cut or in_drawer and is_addon %}
        {% if is_custom_cut %}
          <cart-qty-control data-key="{{ item.key }}" data-quantity="{{ item.quantity }}">
            <div class="inline-flex items-center space-x-2 cart-qty-component border p-1 rounded-lg shadow-lg" aria-live="polite">
              <button
                type="button"
                class="dec w-8 h-8 flex items-center justify-center text-gray-700 hover:text-bg-light-red cursor-pointer"
                aria-label="Remove item"
                data-minus
                data-quantity="0"
              >
                {% render 'icon-trash-svg', class: 'size-4' %}
              </button>
              <span class="w-12 text-center text-sm">{{ item.quantity }}</span>
            </div>
          </cart-qty-control>
        {% else %}
          <div class="text-sm text-gray-700">Qty: {{ item.quantity }}</div>
        {% endif %}
      {% else %}
        {% render 'cart-qty-control', key: item.key, qty: item.quantity, is_addon: has_addons %}
      {% endif %}
    </div>
  </div>
</div>
