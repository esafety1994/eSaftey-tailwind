<!-- Product media gallery snippet -->
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign start_index = 0 -%}
{%- assign is_best_seller = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_norm = tag | downcase | replace: ' ', '-' -%}
  {%- if tag_norm == 'best-seller' or tag_norm == 'bestseller' -%}
    {%- assign is_best_seller = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign media_size = product.media.size -%}
{%- assign mobile_thumb_limit = 4 -%}
{%- assign hidden_thumb_count = media_size | minus: mobile_thumb_limit -%}

{%- if current_variant -%}
  {%- if current_variant.featured_image -%}
    {%- for m in product.media -%}
      {%- if m.preview_image and m.preview_image.src == current_variant.featured_image.src -%}
        {%- assign start_index = forloop.index0 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif current_variant.image -%}
    {%- for m in product.media -%}
      {%- if m.preview_image and m.preview_image.src == current_variant.image.src -%}
        {%- assign start_index = forloop.index0 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

<div class="max-w-xl m-auto">
  <div
    class="glide"
    id="esProductGlide"
    data-start-index="{{ start_index }}"
    data-esProductGlideCount="{{ product.media.size }}"
  >
    <div class="relative">
    {% if is_best_seller %}
      <div class="pdp-best-seller-badge md:hidden">BEST SELLER</div>
    {% endif %}
    <div class="glide__track" data-glide-el="track">
      <ul class="glide__slides">
        {% for media in product.media %}
          <li class="glide__slide">
            <div class="relative group">
              {% case media.media_type %}
                {% when 'image' %}
                  <img
                    src="{{ media | img_url: '900x900' }}"
                    alt="{{ media.alt | escape }}"
                    class="w-full max-h-[576px] object-contain m-auto hover:cursor-pointer"
                    width="576"
                    height="576"
                    {% unless forloop.first %}loading="lazy"{% endunless %}
                  >

                {% when 'video' %}
                  <div class="media-wrap">
                    {%- assign poster = media.preview_image | image_url: width: 1600 -%}
                    {%- assign mp4 = media.sources | where: 'format', 'mp4' | sort: 'height' | last -%}
                    <video
                      controls
                      preload="metadata"
                      playsinline
                      poster="{{ poster }}"
                    >
                      {% if mp4 and mp4.url %}
                        <source src="{{ mp4.url }}" type="video/mp4">
                      {% endif %}
                      Your browser does not support the video tag.
                    </video>
                  </div>

                {% when 'external_video' %}
                  <div class="media-wrap">
                    {{ media | media_tag }}
                  </div>

                {% else %}
                  <div class="media-wrap">
                    {{ media | media_tag }}
                  </div>
              {% endcase %}

              <!-- Zoom overlay button (appears on hover) -->
              <button
                type="button"
                class="slide-zoom-btn absolute top-3 right-3 opacity-0 group-hover:!opacity-100 group-focus:opacity-100 transition bg-black bg-opacity-60 hover:bg-opacity-80 rounded-full w-9 h-9 flex items-center justify-center text-white z-40 m-tooltip--left hover:cursor-pointer"
                aria-label="Open fullscreen"
              >
                {% render 'icon-svg-zoom-in', class: 'size-5 pointer-events-none text-white' %}
                <span class="m-tooltip__content hidden bg-black text-white text-xs rounded px-2 py-1 whitespace-nowrap shadow z-50">
                  View fullscreen
                </span>
              </button>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
    {% if product.media.size > 1 %}
      <div id="pdp-slide-counter" class="pdp-slide-counter">1/{{ product.media.size }}</div>
      <div id="pdp-slide-dots" class="pdp-slide-dots md:hidden" aria-hidden="true">
        {% for media in product.media %}
          <button
            type="button"
            class="pdp-slide-dot{% if forloop.index0 == start_index %} is-active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
    </div>

    <!-- prev/next arrows (absolute, vertically centered) -->
    <div data-glide-el="controls">
      <button
        class="product-gallery-arrow product-gallery-arrow--left focus-visible:outline-none"
        data-glide-dir="<"
        aria-label="Previous"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        class="product-gallery-arrow product-gallery-arrow--right focus-visible:outline-none"
        data-glide-dir=">"
        aria-label="Next"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <!-- Thumbnails carousel (desktop) -->
    {% if show_thumbs != false %}
      <div class="mt-3 hidden md:block" data-glide-el="controls[nav]">
        <div class="glide product-thumbs" id="esProductThumbs">
          <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">
              {% for media in product.media %}
                <li class="glide__slide px-1 max-w-32">
                  <button class="thumb-btn relative focus:outline-none" data-thumb-index="{{ forloop.index0 }}">
                    <img
                      src="{{ media.preview_image | image_url: width: 250, height: 250, crop: 'center' }}"
                      alt="{{ media.alt | escape }}"
                      class="rounded w-[110px] h-[110px] object-cover m-auto"
                      width="110"
                      height="110"
                      {% unless forloop.first %}loading="lazy"{% endunless %}
                    >

                    {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                      <span class="thumb-play-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
                          <polygon points="5,3 19,12 5,21" />
                        </svg>
                      </span>
                    {% endif %}
                  </button>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>

      <!-- Thumbnails grid (mobile, 4 + "+N more") -->
      {% if media_size > 1 %}
        <div class="pdp-thumbs-mobile md:hidden mt-3 px-1">
          {% for media in product.media limit: mobile_thumb_limit %}
            <button
              type="button"
              class="pdp-thumb-mobile{% if forloop.index0 == start_index %} is-active{% endif %}"
              data-mobile-thumb-index="{{ forloop.index0 }}"
              aria-label="Show image {{ forloop.index }}"
            >
              <img
                src="{{ media.preview_image | image_url: width: 200, height: 200, crop: 'center' }}"
                alt="{{ media.alt | escape }}"
                width="70"
                height="70"
                loading="lazy"
              >
              {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                <span class="pdp-thumb-mobile-play">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                    <polygon points="5,3 19,12 5,21"/>
                  </svg>
                </span>
              {% endif %}
            </button>
          {% endfor %}

          {% if hidden_thumb_count > 0 %}
            <button
              type="button"
              class="pdp-thumb-mobile pdp-thumb-mobile--more"
              data-pdp-more-thumbs
              aria-label="Show all images"
            >
              <span class="pdp-thumb-mobile-more-count">+{{ hidden_thumb_count }}</span>
              <span class="pdp-thumb-mobile-more-label">more</span>
            </button>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<!-- Lightbox modal (Glide slider) -->
<div id="product-lightbox" class="hidden fixed inset-0 z-55 bg-white bg-opacity-75 items-center justify-center p-4">
  <div class="w-full max-w-4xl relative">
    <div class="glide glide-lightbox" id="product-lightbox-glide">
      <div class="glide__track" data-glide-el="track">
        <ul class="glide__slides">
          {% for media in product.media %}
            <li class="glide__slide">
              {% case media.media_type %}
                {% when 'image' %}
                  <img
                    src="{{ media | img_url: '1600x1600' }}"
                    alt="{{ media.alt | escape }}"
                    class="w-auto h-auto max-h-[90vh] m-auto"
                    width="1600"
                    height="1600"
                  >

                {% when 'video' %}
                  <div class="lb-media-wrap">
                    {%- assign poster = media.preview_image | image_url: width: 1600 -%}
                    {%- assign mp4 = media.sources | where: 'format', 'mp4' | sort: 'height' | last -%}
                    <video
                      class="lb-video"
                      controls
                      playsinline
                      preload="metadata"
                      poster="{{ poster }}"
                    >
                      {% if mp4 and mp4.url %}
                        <source src="{{ mp4.url }}" type="video/mp4">
                      {% endif %}
                      Your browser does not support the video tag.
                    </video>
                  </div>

                {% when 'external_video' %}
                  <div class="lb-media-wrap">
                    {{ media | media_tag }}
                  </div>

                {% else %}
                  <div class="lb-media-wrap">
                    {{ media | media_tag }}
                  </div>
              {% endcase %}
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- lightbox close (positioned top-right of container) -->
      <button
        id="product-lightbox-close"
        class="absolute top-2 right-2 text-white text-2xl bg-black bg-opacity-40 rounded-full w-8 h-8 flex items-center justify-center hover:cursor-pointer"
        aria-label="Close"
      >
        &times;
      </button>

      <div data-glide-el="controls">
        <button class="product-gallery-arrow product-gallery-arrow--left" data-glide-dir="<" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="product-gallery-arrow product-gallery-arrow--right" data-glide-dir=">" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'product-media.js' | asset_url }}" defer></script>
<script>
  (function () {
    var total = {{ product.media.size }};
    var counter = document.getElementById('pdp-slide-counter');
    var dotsEl = document.getElementById('pdp-slide-dots');
    var mobileThumbs = document.querySelectorAll('[data-mobile-thumb-index]');
    var moreBtn = document.querySelector('[data-pdp-more-thumbs]');

    function setActive(idx) {
      if (counter) counter.textContent = (idx + 1) + '/' + total;
      if (dotsEl) {
        dotsEl.querySelectorAll('.pdp-slide-dot').forEach(function (d, i) {
          d.classList.toggle('is-active', i === idx);
        });
      }
      mobileThumbs.forEach(function (t) {
        var ti = parseInt(t.getAttribute('data-mobile-thumb-index'), 10);
        t.classList.toggle('is-active', ti === idx);
      });
    }

    function attach() {
      var glideEl = document.getElementById('esProductGlide');
      if (glideEl && glideEl._glideInstance) {
        var g = glideEl._glideInstance;
        setActive(g.index);
        g.on('run.after', function () { setActive(g.index); });

        if (dotsEl) {
          dotsEl.querySelectorAll('.pdp-slide-dot').forEach(function (d, i) {
            d.addEventListener('click', function () { g.go('=' + i); });
          });
        }
        mobileThumbs.forEach(function (t) {
          t.addEventListener('click', function () {
            var i = parseInt(t.getAttribute('data-mobile-thumb-index'), 10);
            g.go('=' + i);
          });
        });
      } else {
        setTimeout(attach, 150);
      }
    }
    attach();

    // "+N more" opens the lightbox
    if (moreBtn) {
      moreBtn.addEventListener('click', function () {
        var lb = document.getElementById('product-lightbox');
        if (!lb) return;
        lb.classList.remove('hidden');
        lb.style.display = 'flex';
      });
    }
  })();
</script>
