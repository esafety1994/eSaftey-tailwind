{%- assign _customer_tags_lower = customer.tags | join: ',' | downcase -%}
{%- assign _is_b2b = false -%}
{%- if customer -%}
  {%- if _customer_tags_lower contains 'b2b' -%}
    {%- assign _is_b2b = true -%}
  {%- elsif customer.company != blank -%}
    {%- assign _is_b2b = true -%}
  {%- elsif customer.company_available_locations.size > 0 -%}
    {%- assign _is_b2b = true -%}
  {%- endif -%}
{%- endif -%}
{%- comment -%}
  Post-login routing is handled by the customer-account extension on the
  account subdomain (not the theme):
    - B2B customer → extension redirects them to /pages/dashboard
    - D2C customer → stays on the default /account page
  Non-logged-in visitors go through Shopify's standard NCA login flow.
{%- endcomment -%}
{%- if _is_b2b -%}
  {%- assign _account_url = '/pages/dashboard?view=dashboard' -%}
{%- else -%}
  {%- assign _account_url = '/account' -%}
{%- endif -%}
<div class="flex md:space-x-2 items-center text-white mr-2">
  {%- if _is_b2b -%}
    <div class="esa-adv-badge hidden lg:flex flex-col self-start" style="flex-shrink:0;background:#FEEB06;border-radius:0 0 20px 20px;overflow:hidden;line-height:1;white-space:nowrap;margin-top:-8px;margin-right:60px;padding:6px 6px 0 6px;">
      <div style="background:#000;padding:11px 18px;display:flex;align-items:center;justify-content:center;">
        <img src="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/Advantage_Logo_1-2.png?v=1789450482" alt="eSafety Advantage" style="height:28px;width:auto;display:block;" width="191" height="28">
      </div>
      <div style="color:#000;padding:8px 18px;text-align:center;font-weight:700;font-size:15px;letter-spacing:0.04em;">
        TRADE PRICING:&nbsp;<span style="font-weight:900;">ON</span>
      </div>
    </div>
  {%- endif -%}
  <!-- Profile/User Icon with Tailwind-only tooltip -->
  <a href="{{ _account_url }}" id="profile-btn" class="p-1 rounded hover:text-primary transition group m-tooltip--top icon-tooltip-btn" aria-label="Account">
    <span class="inline-flex relative">{% render 'icon-svg-user', class: 'size-6 cursor-pointer' %}
      <span aria-hidden="true" class="m-tooltip__content hidden absolute top-full mt-2 left-1/2 bg-white text-black text-xs rounded-md p-1.5 whitespace-no-wrap shadow z-50">
        Account
      </span>
    </span>
  </a>
  {% render 'quotify-button' %}
</div>
