<!-- Cart progress bar for active cart-value promos -->
{%- comment -%}
  Renders a cart-value progress bar inside the cart drawer and cart page.
  Active promo: Father's Day FAK Giveaway (2026-09-01 → 2026-09-06 AEST).
  For a new promo, update the promo_start_ts, promo_end_ts, threshold, and messaging below.
{%- endcomment -%}

{%- assign current = cart.checkout_charge_amount | default: 0 | plus: 0 -%}
{%- assign threshold = 49900 -%}
{%- assign pct = 0 -%}
{%- if threshold > 0 -%}
  {%- assign pct = current | times: 100 | divided_by: threshold | round -%}
  {%- if pct > 100 -%}
    {%- assign pct = 100 -%}
  {%- endif -%}
{%- endif -%}

{%- assign unlocked = false -%}
{%- if threshold > 0 and current >= threshold -%}
  {%- assign unlocked = true -%}
{%- endif -%}

{%- assign fill_class = 'bg-primary' -%}
{%- if unlocked -%}
  {%- assign fill_class = 'bg-emerald-600' -%}
{%- endif -%}

{%- comment -%} if cart contains any product tagged 'bulky', do not render {%- endcomment -%}
{%- assign bulky = false -%}
{%- for item in cart.items -%}
  {%- if item.product and item.product.tags and item.product.tags contains 'Bulky' -%}
    {%- assign bulky = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Father's Day FAK Giveaway banner — active 2026-09-01 → 2026-09-06 AEST {%- endcomment -%}
{%- assign now_ts = 'now' | date: '%s' | plus: 0 -%}
{%- assign promo_start_ts = '2026-09-01T00:00:00+10:00' | date: '%s' | plus: 0 -%}
{%- assign promo_end_ts = '2026-09-07T00:00:00+10:00' | date: '%s' | plus: 0 -%}

{%- if now_ts >= promo_start_ts and now_ts < promo_end_ts -%}
{%- unless bulky -%}
<div class="w-full my-4 p-4 bg-yellow-50 border border-yellow-300 rounded-lg">
  <div class="flex items-start gap-3">
    <div class="text-2xl leading-none flex-shrink-0" aria-hidden="true">🎁</div>
    <div class="flex-1">
      {%- if unlocked -%}
        <p class="text-sm font-semibold text-emerald-700">You've unlocked a FREE Dad's First Aid Kit!</p>
        <p class="text-xs text-gray-600 mt-1">Added to your cart at no extra cost.</p>
      {%- else -%}
        <p class="text-sm text-gray-800">
          Spend <span class="font-semibold">{{ threshold | minus: current | money }}</span> more to unlock a <strong>FREE Dad's First Aid Kit</strong>
        </p>
      {%- endif -%}
      <div class="mt-2">
        <div class="relative w-full h-2 bg-gray-200 rounded-full overflow-hidden">
          <div
            class="absolute inset-0 {{ fill_class }} rounded-full"
            style="width: {{ pct }}%; transition: width 450ms cubic-bezier(.2,.9,.2,1);"
          ></div>
        </div>
      </div>
    </div>
  </div>
</div>
{%- endunless -%}
{%- endif -%}
