  <div class="pdp-trust-item">
    {% render 'icon-svg-truck', class: 'pdp-trust-icon', stroke_width: 1.5 %}
    <span><strong>Clear Shipping Costs</strong> Before Checkout. No Surprises</span>
  </div>
  <div class="pdp-trust-item">
    {% render 'icon-svg-percent-badge', class: 'pdp-trust-icon', stroke_width: 1.5 %}
    <span><strong>5% Price Beat</strong> Guaranteed</span>
  </div>
  <div class="pdp-trust-item">
    {% render 'icon-svg-store', class: 'pdp-trust-icon', stroke_width: 1.5 %}
    <span><strong>Click &amp; Collect</strong> in under 24 hours</span>
  </div>
  <div class="pdp-trust-item">
    {% render 'icon-svg-package', classes: 'pdp-trust-icon', stroke_width: 1.5 %}
