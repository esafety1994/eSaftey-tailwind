<!-- Delivery + Shipping info card -->
<div class="pdp-main-card mt-5 mb-3">

  {%- comment -%} Hide ETA when variant is on backorder — the backorder note already carries the real delivery date {%- endcomment -%}
  {%- assign _eta_variant = product.selected_or_first_available_variant -%}
  {%- assign _eta_status = '' -%}
  {%- if _eta_variant.metafields.custom.stock_status -%}
    {%- assign _eta_status = _eta_variant.metafields.custom.stock_status.value | default: _eta_variant.metafields.custom.stock_status -%}
  {%- endif -%}

  <!-- Estimated Delivery Header -->
  <div id="product-eta-row">
    {% if _eta_status != 'Back Order' %}
      <div class="pdp-delivery-row">
        <div class="pdp-truck-circle">
          {% render 'icon-svg-truck', class: 'pdp-truck-icon', stroke_width: 1.5 %}
        </div>
        <div class="pdp-delivery-text-wrap">
          <span class="pdp-delivery-label">Estimated delivery</span>
          <strong id="pdp-eta-dates" class="pdp-delivery-dates">–</strong>
        </div>
      </div>
    {% endif %}
  </div>


  <!-- 3-column info grid (horizontal layout: icon left, text right) -->
  <div class="pdp-info-grid">

    <!-- Click & Collect -->
    <button type="button" class="pdp-info-box" id="pdp-cc-toggle" aria-expanded="true" aria-controls="pdp-cc-expand">
      <div class="pdp-box-icon-wrap">
        {% render 'icon-svg-store', class: 'pdp-box-icon pdp-icon-gray', stroke_width: 1.25 %}
      </div>
      <div class="pdp-box-text">
        <p class="pdp-box-title">Click &amp; Collect</p>
        <p class="pdp-box-sub">Available in <span data-cc-state-count>3</span> states</p>
        <span class="pdp-box-link">View locations</span>
      </div>
    </button>

    <!-- Shipping Cost -->
    <a href="#" onclick="triggerShippingEstimate(event)" class="pdp-info-box">
      <div class="pdp-box-icon-wrap">
        {% render 'icon-svg-package', classes: 'pdp-box-icon pdp-icon-orange', stroke_width: 1.25 %}
      </div>
      <div class="pdp-box-text">
        <p class="pdp-box-title">Shipping Cost</p>
        <p class="pdp-box-sub">Calculate now</p>
        <span class="pdp-box-link">Get exact cost ›</span>
      </div>
    </a>

    <!-- Price Beat -->
    <button type="button" class="pdp-info-box" data-price-beat-open>
      <div class="pdp-box-icon-wrap">
        {% render 'icon-svg-percent-badge', class: 'pdp-box-icon pdp-icon-orange', stroke_width: 1.5 %}
      </div>
      <div class="pdp-box-text">
        <p class="pdp-box-title">Price Beat</p>
        <p class="pdp-box-sub">Get better price</p>
        <span class="pdp-box-link">Claim now ›</span>
      </div>
    </button>

  </div>

  <!-- C&C expandable section (inside the card) -->
  <div class="pdp-cc-expand" id="pdp-cc-expand" data-pickup-panel>

    <div class="pdp-cc-header">
      <div class="pdp-cc-header-left">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>This product is available for pickup in selected states.</span>
      </div>
      <button type="button" class="pdp-cc-close-btn" id="pdp-cc-close" aria-label="Collapse">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24">
          <path d="M18 15l-6-6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="pdp-cc-inner">

      <!-- Left: locations table -->
      <div class="pdp-cc-left">
        <h4 class="pdp-cc-heading">Click &amp; Collect Locations</h4>

        <div class="pdp-cc-locations" data-pickup-locations>

          <!-- NSW -->
          <div class="pdp-cc-loc-row" data-location="W1">
            <div class="pdp-cc-loc-state">NSW</div>
            <div class="pdp-cc-loc-info">
              <strong class="pdp-cc-loc-name">Sydney Warehouse</strong>
              <div class="pdp-cc-loc-address">
                <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Wetherill Park, 2164</span>
              </div>
            </div>
            <div class="pdp-cc-loc-ready">
              <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <p class="pdp-cc-loc-ready-label">Usually ready:</p>
                <p class="pdp-cc-loc-ready-sub">Same day or next business day</p>
              </div>
            </div>
            <div class="pdp-cc-loc-stock">
              <span class="pdp-cc-loc-badge pdp-cc-badge-available" data-stock-badge>Available</span>
            </div>
          </div>

          <!-- QLD -->
          <div class="pdp-cc-loc-row" data-location="QW">
            <div class="pdp-cc-loc-state">QLD</div>
            <div class="pdp-cc-loc-info">
              <strong class="pdp-cc-loc-name">Brisbane Warehouse</strong>
              <div class="pdp-cc-loc-address">
                <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Port Of Brisbane, 4178</span>
              </div>
            </div>
            <div class="pdp-cc-loc-ready">
              <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <p class="pdp-cc-loc-ready-label">Usually ready:</p>
                <p class="pdp-cc-loc-ready-sub">Same day or next business day</p>
              </div>
            </div>
            <div class="pdp-cc-loc-stock">
              <span class="pdp-cc-loc-badge pdp-cc-badge-available" data-stock-badge>Available</span>
            </div>
          </div>

          <!-- VIC -->
          <div class="pdp-cc-loc-row" data-location="VW">
            <div class="pdp-cc-loc-state">VIC</div>
            <div class="pdp-cc-loc-info">
              <strong class="pdp-cc-loc-name">Melbourne Warehouse</strong>
              <div class="pdp-cc-loc-address">
                <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Altona, 3018</span>
              </div>
            </div>
            <div class="pdp-cc-loc-ready">
              <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <p class="pdp-cc-loc-ready-label">Usually ready:</p>
                <p class="pdp-cc-loc-ready-sub">Same day or next business day</p>
              </div>
            </div>
            <div class="pdp-cc-loc-stock">
              <span class="pdp-cc-loc-badge pdp-cc-badge-available" data-stock-badge>Available</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Right: action buttons -->
      <div class="pdp-cc-right">
        <a href="/pages/click-and-collect" class="pdp-cc-btn-primary">View Click &amp; Collect Locations</a>
        <button type="button" class="pdp-cc-btn-secondary" onclick="triggerShippingEstimate(event)">Calculate delivery instead</button>
        <a href="/pages/click-and-collect#hours" class="pdp-cc-hours-link">View pickup hours</a>
      </div>

    </div>
  </div>

</div>

{% render 'price-beat-modal', product: product %}

