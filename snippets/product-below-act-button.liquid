    align-items: center;
    gap: 3px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 9.5px;
    color: #6b7280;
    min-width: 0;
  }
  .pdp-cc-loc-address > svg { flex-shrink: 0; color: #9ca3af; }
  .pdp-cc-loc-address > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

