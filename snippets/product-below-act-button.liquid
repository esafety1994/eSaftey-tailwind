    font-weight: 700;
    color: #111827;
    margin: 0;
    line-height: 1.2;
  }

  .pdp-cc-loc-stock {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 68px;
  }
  .pdp-cc-loc-badge {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 100px;
    white-space: nowrap;
    line-height: 1.3;
  }
