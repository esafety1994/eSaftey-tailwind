    padding: 10px 8px;
    background: transparent;
    color: #111827;
    border: 1.5px solid #111827;
    border-radius: 6px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: background 0.15s;
    display: block;
    line-height: 1.25;
  }
  .pdp-cc-btn-secondary:hover { background: #f9fafb; }
  .pdp-cc-hours-link {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 11px;
