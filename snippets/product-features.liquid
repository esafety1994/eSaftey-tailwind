{% comment %}
  product-features.liquid
  Shows the first 3 bullet points of the FIRST <ul> in product.description,
  next to the price. No "Features" heading is needed in the description.
  Falls back to the old "Features"/"Benefits" text search for old
  descriptions that have no <ul>.
  Usage: {% render 'product-features', product: product %}
{% endcomment %}
{%- liquid
  assign desc = product.description | default: ''
  assign bullets = ''
  assign sep = '|||'

  if desc contains '<ul'
    assign chunks = desc | split: '<ul'
    assign first_ul = chunks[1] | split: '</ul>' | first
    assign lis = first_ul | split: '<li'
    assign taken = 0
    for raw in lis offset: 1
      assign item = raw | prepend: '<li' | strip_html | strip
      if item != '' and taken < 3
        assign bullets = bullets | append: item | append: sep
        assign taken = taken | plus: 1
      endif
    endfor
  else
    assign desc_down = desc | downcase
    assign after = ''
    if desc_down contains 'features'
      assign after = desc | split: 'eatures' | last
    elsif desc_down contains 'benefits'
      assign after = desc | split: 'enefits' | last
    endif
    if after != ''
      assign normalized = after | replace: '</p>', sep | replace: '<br>', sep | replace: '<br/>', sep | replace: '</li>', sep | strip_html
      assign parts = normalized | split: sep
      assign taken = 0
      for part in parts
        assign item = part | strip | remove_first: ':' | remove_first: '•' | strip
        if item.size > 1 and taken < 3
          assign bullets = bullets | append: item | append: sep
          assign taken = taken | plus: 1
        endif
      endfor
    endif
  endif

  assign items = bullets | split: sep
-%}
{% if items.size > 0 %}
  <div>
    <h4 class="text-base font-semibold mb-2">Features:</h4>
    <ul class="product-features-list list-disc ml-6">
      {% for item in items %}
        <li class="text-sm">{{ item }}</li>
      {% endfor %}
    </ul>
    <button
      type="button"
      class="mt-4 cursor-pointer show-full-desc inline-flex items-center font-semibold text-sm text-gray-600 underline focus:outline-none"
      aria-expanded="false"
      aria-controls="product-details-target"
    >
      <span>Show full description</span>
      <svg class="ml-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M14.456 11.944L9.6 16.8 4.744 11.944" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M9.6 3.2V16.664" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
{% endif %}
