{% comment %}
  product-features.liquid
  Renders up to the first three bullet points found under a "Features" section
  in `product.description` (handles HTML <li> lists and simple dash/• bullets).
  Usage: {% render 'product-features', product: product %}
{% endcomment %}
{% assign desc = product.description | default: '' %}
{% assign desc_down = desc | downcase %}
{% assign after = '' %}

{% if desc_down contains 'features' %}
  {% assign after = desc_down | split: 'features' | last %}
{% elsif desc_down contains 'benefits' %}
  {% assign after = desc_down | split: 'benefits' | last %}
{% endif %}

{% if after != '' %}
  {%- comment -%}
    Normalize common block breaks and strip all HTML/tags so any attributes
    like data-start/data-end are removed before we split into bullets.
  {%- endcomment -%}
  {% assign normalized = after
    | replace: '</p>', '\n'
    | replace: '<br>', '\n'
    | replace: '<br/>', '\n'
    | replace: '</li>', '\n'
  %}
  {% assign normalized = normalized | strip_html %}

  {%- comment -%} Prefer newline-separated items, then bullet char, then dashes. {%- endcomment -%}
  {% if normalized contains '\n' %}
    {% assign parts = normalized | split: '\n' %}
  {% elsif normalized contains '•' %}
    {% assign parts = normalized | split: '•' %}
  {% else %}
    {% assign parts = normalized | split: '-' %}
  {% endif %}

  {% if mobile %}
    <div class="pdp-feat-grid">
      {% assign taken = 0 %}
      {% for part in parts %}
        {% assign item = part | strip | replace_first: '&bull;', '' | replace_first: '•', '' %}
        {% assign item = item | replace_first: '>', '' | replace_first: ':', '' | replace_first: '\t', '' | strip %}
        {% if item != '' and item != ' ' and item.size > 1 and taken < 4 %}
          {%- assign item_lc = item | downcase -%}
          {%- assign icon_key = 'check' -%}
          {%- if item_lc contains 'no cable' or item_lc contains 'no tool' or item_lc contains 'no drilling' or item_lc contains 'without' -%}
            {%- assign icon_key = 'no-cable' -%}
          {%- elsif item_lc contains 'weather' or item_lc contains 'uv' or item_lc contains 'water' or item_lc contains 'strong' or item_lc contains 'heavy' or item_lc contains 'durable' or item_lc contains 'galvani' or item_lc contains 'stainless' -%}
            {%- assign icon_key = 'shield' -%}
          {%- elsif item_lc contains 'install' or item_lc contains 'quick' or item_lc contains 'fast' or item_lc contains 'easy' or item_lc contains 'second' or item_lc contains 'minute' -%}
            {%- assign icon_key = 'clock' -%}
          {%- elsif item_lc contains 'reusable' or item_lc contains 'long lasting' or item_lc contains 'lifetime' or item_lc contains 'reuse' -%}
            {%- assign icon_key = 'refresh' -%}
          {%- elsif item_lc contains 'aussie' or item_lc contains 'australia' or item_lc contains 'made' -%}
            {%- assign icon_key = 'flag' -%}
          {%- elsif item_lc contains 'certif' or item_lc contains 'compliant' or item_lc contains 'standard' or item_lc contains 'as/nzs' -%}
            {%- assign icon_key = 'award' -%}
          {%- endif -%}

          <div class="pdp-feat">
            <div class="pdp-feat-icon">
              {%- case icon_key -%}
                {%- when 'no-cable' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Z"/><path d="m9 9 6 6M15 9l-6 6"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- when 'refresh' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
                {%- when 'flag' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4"/><path d="M4 4h13l-2 4 2 4H4"/></svg>
                {%- when 'award' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="m8.2 13.5-1.7 7.5L12 18l5.5 3-1.7-7.5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>
              {%- endcase -%}
            </div>
            <span class="pdp-feat-label">{{ item | truncate: 32 }}</span>
          </div>
          {% assign taken = taken | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div>
      <h4 class="text-base font-semibold mb-2">Features:</h4>
      <ul class="product-features-list list-disc ml-6">
        {% assign taken = 0 %}
        {% for part in parts %}
          {% assign item = part | strip | replace_first: '&bull;', '' | replace_first: '•', '' %}
          {% assign item = item | replace_first: '>', '' | replace_first: ':', '' | replace_first: '\t', '' | strip %}
          {% if item != '' and item != ' ' and item.size > 1 and taken < 3 %}
            <li class="text-sm capitalize">{{ item }}</li>
            {% assign taken = taken | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ul>
      <button
        type="button"
        class="mt-4 cursor-pointer show-full-desc inline-flex items-center font-semibold text-sm text-gray-600 underline focus:outline-none"
        aria-expanded="false"
        aria-controls="product-details-target"
      >
        <span>Show full description</span>
        <svg class="ml-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M14.456 11.944L9.6 16.8 4.744 11.944" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9.6 3.2V16.664" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  {% endif %}
{% endif %}
