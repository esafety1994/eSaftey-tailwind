{% comment %}
  sticky-product-cart.liquid
  Mobile: compact bar with image, title, price + cart button (pinned bottom).
  Desktop: full bar with image, title, reviews, SKU, price, qty, Add to Cart.
{% endcomment %}

{% assign img = product.selected_or_first_available_variant.featured_image | default: product.images.first %}

<div
  data-sticky-cart
  class="block fixed left-0 right-0 z-50 transition-transform duration-200 sticky-cart"
  aria-hidden="false"
>
  <div class="bg-white border-t border-gray-200" style="box-shadow: 0 -4px 10px rgba(0,0,0,0.07);">

    {% comment %} Mobile layout (< lg) {% endcomment %}
    <div class="flex items-center justify-between gap-3 px-3 py-2 lg:hidden">
      <div class="flex items-center gap-2 min-w-0 flex-1">
        <div class="w-10 h-10 flex-shrink-0 rounded overflow-hidden bg-gray-100">
          {% if img %}
            <img
              src="{{ img | image_url: '100x' }}"
              alt="{{ product.title }}"
              class="sticky-image w-full h-full object-cover"
              width="40"
              height="40"
            >
          {% else %}
            <div class="bg-gray-100 w-full h-full"></div>
          {% endif %}
        </div>
        <div class="min-w-0">
          <div class="text-xs font-semibold truncate text-gray-800 max-w-[160px]">{{ product.title }}</div>
          <div class="text-sm font-bold" id="sticky-price">
            {% render 'product-price',
              product: product,
              show_compare_price: false,
              price_size: '14px',
              layout: 'sticky',
              show_ex_gst: true
            %}
          </div>
        </div>
      </div>
      <div class="flex-shrink-0 flex items-center gap-2">
        <input type="hidden" name="sticky-variant-id" value="{{ product.selected_or_first_available_variant.id }}">
        {% render 'act-button', product: product, layout: 'sticky', hide_qty: true %}
      </div>
    </div>

    {% comment %} Desktop layout (lg+) {% endcomment %}
    <div class="hidden lg:grid lg:grid-cols-2 gap-4 max-w-4xl m-auto p-3">
      <div class="flex items-start gap-2">
        <div class="size-16">
          {% if img %}
            <img
              src="{{ img | image_url: '200x' }}"
              alt="{{ product.title }}"
              class="sticky-image w-full h-full object-cover"
              width="64"
              height="64"
            >
          {% else %}
            <div class="bg-gray-100 w-full h-full"></div>
          {% endif %}
        </div>
        <div class="flex items-center justify-between gap-4">
          <div class="truncate">
            <div class="text-sm font-semibold truncate">{{ product.title }}</div>
            {% render 'product-review', product: product %}
            <div class="text-xs text-gray-600 mt-1">
              SKU: <span class="sticky-sku">{{ product.selected_or_first_available_variant.sku }}</span>
              <input
                type="hidden"
                name="sticky-variant-id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >
            </div>
          </div>
        </div>
      </div>
      <div class="flex justify-between items-center gap-4">
        <div class="text-right ml-4">
          <div class="text-lg font-semibold">
            {% render 'product-price',
              product: product,
              show_compare_price: false,
              price_size: '14px',
              layout: 'sticky',
              show_ex_gst: true
            %}
          </div>
        </div>
        <div class="max-w-sm">
          {% render 'act-button', product: product, layout: 'sticky' %}
        </div>
      </div>
    </div>

  </div>
</div>

<script src="{{ 'sticky-cart.js' | asset_url }}" defer></script>
