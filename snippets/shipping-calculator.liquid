{%- assign variant = product.variants.first | default: product.selected_or_first_available_variant -%}

{%- capture item_grams -%}
{%- assign raw_weight = variant.weight | plus: 0 -%}
{%- if variant.weight_unit == 'kg' -%}
  {%- comment -%}If the raw weight is already large (likely grams), don't multiply again{%- endcomment -%}
  {%- if raw_weight < 1000 -%}
    {{ raw_weight | times: 1000 | round }}
  {%- else -%}
    {{ raw_weight | round }}
  {%- endif -%}
{%- else -%}
  {%- if variant.grams -%}
    {{ variant.grams }}
  {%- else -%}
    {{ raw_weight | round }}
  {%- endif -%}
{%- endif -%}
{%- endcapture -%}

{%- capture required_product -%}
{
  "title": {{ product.title | json }},
  "sku": {{ variant.sku | json }},
  "price": {{ variant.price | default: product.price }},
  "grams": {{ item_grams | strip }},
  "image": {{ variant.image | default: product.featured_image | image_url: width: 200 | json }},
  "variant_id": {{ variant.id }}
}
{%- endcapture -%}

<shipping-calculator class="shipping-calculator" data-product='{{ required_product | strip }}'>

  <!-- Header -->
  <header class="m-cart-addon__title">
    <div class="sc-header-left">
      <svg class="sc-header-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>Shipping details</span>
    </div>
    <button class="shipping-cal-close" aria-label="Close">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
    </button>
  </header>

  <div class="shipping-calc-scroll">
    <div class="sc-body">

      <!-- Trust banner -->
      <div class="sc-trust">
        <svg class="sc-trust-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" fill-rule="evenodd"></path>
        </svg>
        <p>Clear shipping pricing. No surprises at checkout.</p>
      </div>

      <!-- Title + intro -->
      <div class="sc-intro">
        <h2 class="sc-title">Check shipping cost &amp; ETA</h2>
        <p class="sc-subtitle">Enter your postcode for an instant delivery estimate before checkout.</p>
      </div>

      <!-- Form fields -->
      <form data-address="root" class="sc-form">
        <div class="sc-field">
          <label class="sc-label" for="QuantityShipping">{{ 'products.product.quantity' | t }}</label>
          <input
            class="sc-input"
            type="number"
            inputmode="numeric"
            pattern="\d*"
            min="1"
            step="1"
            id="QuantityShipping"
            name="quantity"
            value="1"
          >
        </div>

        <!-- Hidden address fields required by the JS -->
        <div class="sc-field-hidden">
          <input class="form-field" type="text" id="AddressFirstName" name="address[first_name]" value="{{ form.first_name }}">
        </div>
        <div class="sc-field-hidden">
          <input class="form-field" type="text" id="AddressLastName" name="address[last_name]" value="{{ form.last_name }}">
        </div>
        <div class="sc-field-hidden">
          <input class="form-field" type="text" id="AddressCompany" name="address[company]" value="{{ form.company }}">
        </div>
        <div class="sc-field-hidden">
          <input class="form-field" type="text" id="AddressAddress1" name="address[address1]" value="{{ form.address1 }}">
        </div>
        <div class="sc-field-hidden">
          <input class="form-field" type="text" id="AddressAddress2" name="address[address2]" value="{{ form.address2 }}">
        </div>
        <div class="sc-field-hidden">
          <input class="form-field" type="text" id="AddressCity" name="address[city]" value="{{ form.city }}">
        </div>
        <div class="sc-field-hidden">
          <select class="form-field" id="AddressCountry" name="address[country]" data-default="AU"></select>
        </div>
        <div class="sc-field-hidden state">
          <select class="form-field" id="AddressProvince" name="address[province]" data-default="{{ form.province }}"></select>
        </div>

        <div class="sc-field">
          <label class="sc-label" for="AddressZip">{{ 'customer.addresses.zip' | t }}</label>
          <input
            class="sc-input"
            type="number"
            inputmode="numeric"
            pattern="\d*"
            id="AddressZip"
            name="address[zip]"
            value="{{ form.zip }}"
            autocapitalize="characters"
          >
        </div>

        <div class="sc-field-hidden">
          <input class="form-field" type="tel" id="AddressPhone" name="address[phone]" value="{{ form.phone }}">
        </div>
      </form>

      <!-- CTA button -->
      <button class="m-spinner-button sc-cta" type="button">
        <span class="sc-cta-label">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Calculate shipping instantly
        </span>
        <span class="m-spinner-icon">
          <span class="calculating">
            <svg class="animate-spin m-svg-icon--medium" width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="display:none;"></circle>
              <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
        </span>
      </button>

      <!-- Result box — always visible so layout never shifts -->
      <div class="sc-result-box">
        <div class="shipping-rates-result"></div>
        <div class="sc-placeholder">
          <div class="sc-placeholder-icon-wrap">
            <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
            </svg>
          </div>
          <p>Enter your postcode to see your shipping cost, ETA, and whether Click &amp; Collect is available in your area.</p>
        </div>
      </div>

      <!-- Feature footer -->
      <div class="sc-badges">
        <div class="sc-badge">
          <div class="sc-badge-icon">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
            </svg>
          </div>
          <span>Click and Collect</span>
        </div>
        <div class="sc-badge">
          <div class="sc-badge-icon">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
            </svg>
          </div>
          <span>Fast Dispatch</span>
        </div>
        <div class="sc-badge">
          <div class="sc-badge-icon">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
            </svg>
          </div>
          <span>Clear pricing. No surprises</span>
        </div>
        <div class="sc-badge">
          <div class="sc-badge-icon">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="11" width="18" height="11" rx="2" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></rect>
              <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
            </svg>
          </div>
          <span>Secure Checkout</span>
        </div>
      </div>

    </div>
  </div><!-- end shipping-calc-scroll -->

</shipping-calculator>

<script>
  (function () {
    var ship = document.querySelector('.shipping-calculator');
    if (!ship) return;

    // Move the calculator to <body> so its z-index is in the root stacking context
    document.body.appendChild(ship);

    // Create backdrop as a direct body child (same root stacking context)
    var backdrop = document.createElement('div');
    backdrop.setAttribute('aria-hidden', 'true');
    backdrop.style.cssText = [
      'display:none',
      'position:fixed',
      'inset:0',
      'z-index:9998',
      'background:rgba(0,0,0,0.35)',
      'cursor:pointer'
    ].join(';');
    document.body.appendChild(backdrop);

    backdrop.addEventListener('click', function () {
      ship.classList.remove('open');
    });

    new MutationObserver(function () {
      backdrop.style.display = ship.classList.contains('open') ? 'block' : 'none';
    }).observe(ship, { attributes: true, attributeFilter: ['class'] });
  })();
</script>

<style>
  /* ── Panel shell ── */
  .shipping-calculator {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    z-index: 9999;
    background: #fff;
    width: 448px;
    transform: translateX(100%);
    transition: transform 0.5s ease-out;
    overflow: hidden;
    border: none;
    border-radius: 0;
    padding: 0;
  }
  .shipping-calculator.open { transform: translateX(0); }
  .shipping-calc-scroll {
    flex: 1;
    overflow-y: auto;
  }
  .sc-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
  }

  /* ── Header ── */
  .shipping-calculator .m-cart-addon__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: linear-gradient(170deg, #fedc13 31.94%, #fac802 99.43%);
    flex-shrink: 0;
  }
  .sc-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sc-header-icon {
    width: 24px;
    height: 24px;
    color: #1a1a1a;
    flex-shrink: 0;
  }
  .shipping-calculator .m-cart-addon__title span {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
  }
  .shipping-cal-close {
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.15s;
  }
  .shipping-cal-close:hover { opacity: 1; }

  /* ── Trust banner ── */
  .sc-trust {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff9e6;
    border: 1px solid #fde68a;
    border-radius: 8px;
    padding: 12px;
  }
  .sc-trust-icon {
    width: 20px;
    height: 20px;
    color: #008a00;
    flex-shrink: 0;
  }
  .sc-trust p {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1f2937;
    margin: 0;
  }

  /* ── Title + intro ── */
  .sc-intro { display: flex; flex-direction: column; gap: 8px; }
  .sc-title {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #111827;
    margin: 0;
    letter-spacing: -0.2px;
  }
  .sc-subtitle {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 14px;
    color: #4b5563;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Form ── */
  .sc-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sc-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sc-field-hidden { display: none; }
  .sc-label {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1f2937;
  }
  .sc-input {
    width: 100%;
    padding: 10px 16px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 15px;
    color: #111827;
    background: #fff;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box;
  }
  .sc-input:focus {
    border-color: #fbbf24;
    box-shadow: 0 0 0 3px rgba(251,191,36,0.25);
  }

  /* ── CTA button ── */
  .sc-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 16px;
    background: #fff;
    border: 2px solid #008a00;
    border-radius: 6px;
    color: #008a00;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-transform: initial;
    transition: background 0.15s;
  }
  .sc-cta:hover:not(:disabled) { background: #f0fdf4; }
  .sc-cta:disabled { opacity: 0.6; cursor: not-allowed; }
  .sc-cta-label {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .shipping-calculator span.m-spinner-icon {
    display: block;
    position: relative;
    top: unset; bottom: unset; left: unset; right: unset;
  }
  .shipping-calculator span.calculating {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shipping-calculator svg.animate-spin.m-svg-icon--medium { display: block; }

  /* ── Results ── */
  .sc-result-box:has(.sc-result-card) {
    border-color: transparent;
    min-height: 0;
  }
  .shipping-calculator .no-shipping-rates {
    padding: 16px;
    display: flex;
    gap: 16px;
    border-radius: 12px;
    background: #f7f5f5;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 14px;
    color: #5d5d5d;
  }
  .shipping-calculator .shipping-errors p {
    color: #dc2626;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 14px;
    margin: 0 0 8px;
  }

  /* ── Result box — always rendered, holds border so layout never shifts ── */
  .sc-result-box {
    border: 2px dashed #e5e7eb;
    border-radius: 12px;
    min-height: 190px;
    display: flex;
    flex-direction: column;
  }

  /* Results rendered inside the box */
  .shipping-rates-result:empty { display: none; }
  .shipping-rates-result:not(:empty) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    width: 100%;
  }

  /* Placeholder fills the box when results are absent */
  .sc-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    text-align: center;
  }
  .shipping-rates-result:not(:empty) + .sc-placeholder { display: none; }
  .sc-placeholder-icon-wrap {
    width: 56px;
    height: 56px;
    background: #f9fafb;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
  }
  .sc-placeholder p {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
    line-height: 1.6;
    max-width: 200px;
    margin: 0;
  }

  /* ── Result box loading spinner ── */
  .sc-rate-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
  }
  .sc-spin {
    width: 36px;
    height: 36px;
    animation: sc-spin-anim 0.75s linear infinite;
  }
  @keyframes sc-spin-anim {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ── Feature badges ── */
  .sc-badges {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding: 14px 12px;
    background: #fff;
    border: 2px solid #fcd34d;
    border-radius: 12px;
  }
  .sc-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  .sc-badge-icon {
    width: 40px;
    height: 40px;
    background: #f9fafb;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #374151;
    flex-shrink: 0;
  }
  .sc-badge span {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #374151;
    line-height: 1.4;
  }

  /* ── C&C detection banner (yellow, sibling above the green card) ── */
  .sc-cc-banner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 10px;
    padding: 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .sc-cc-icon-wrap {
    width: 36px;
    height: 36px;
    background: #fef3c7;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sc-cc-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .sc-cc-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .sc-cc-title {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #1f2937;
  }
  .sc-cc-badge {
    background: #dcfce7;
    color: #15803d;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 100px;
    white-space: nowrap;
    line-height: 1.6;
  }
  .sc-cc-desc {
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 12px;
    color: #6b7280;
    margin: 0;
  }
  .sc-cc-link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 12px;
    color: #6b7280;
    text-decoration: none;
    margin-top: 2px;
  }
  .sc-cc-link:hover { color: #111827; }
  .sc-cc-chevron { flex-shrink: 0; color: #9ca3af; align-self: center; }

  /* ── Green estimate card ── */
  .sc-result-card {
    background: #f0fdf4;
    border: 1.5px solid #86efac;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    width: 100%;
    box-sizing: border-box;
  }
  .sc-estimate-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #15803d;
  }

  /* Delivery detail rows */
  .sc-delivery-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: rgba(255,255,255,0.7);
    border-radius: 8px;
    padding: 10px 12px;
  }
  .sc-delivery-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 13px;
    color: #374151;
  }
  .sc-delivery-date { font-weight: 600; color: #15803d; }

  /* Product row */
  .sc-product-row {
