<div class="quotify-btns">
  <button
    data-quotify
    data-product="{{ product | json | escape }}"
    data-checksum="{{ product | json | prepend: quotify_shop_secret | sha256 }}"
    data-shop="{{ shop.metafields.quotify.shop_id }}"
    data-variant="{{ product.selected_or_first_available_variant.id }}"
    type="button"
    class="btn primary-cart-button !py-1"
  >
    {% render 'icon-svg-circle-plus', classes: 'inline-block mr-1 size-6' %}
    <span>Add to quote</span>
  </button>

  <button
    style=""
    data-quotify-cart
    data-shop="{{ shop.metafields.quotify.shop_id }}"
    type="button"
    class="btn outline-button"    
  >
    View quote
  </button>
</div>
<style>
  .quotify-btns {
    display: flex;
    gap: 10px;
    padding: 12px 0 6px;
    position: relative;
  }
  .quotify-btns button > * {
    pointer-events: none;
  }
  .quotify-add-btn,
  .quotify-view-btn {
    flex: 1;
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: Poppins, 'M-Body-Font', sans-serif;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 12px 16px !important;
    border-radius: 8px;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1.2;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .quotify-add-btn {
    background: #111827 !important;
    color: #fedc13 !important;
    border: none !important;
  }
  .quotify-add-btn:hover { background: #1f2937 !important; color: #fedc13 !important; }
  .quotify-view-btn {
    background: #fff !important;
    color: #111827 !important;
    border: 1.5px solid #111827 !important;
  }
  .quotify-view-btn:hover { background: #f9fafb !important; }
  .quotify-add-icon { flex-shrink: 0; }

  /* Mobile: stack, hide "View quote" */
  @media (max-width: 767px) {
    .quotify-btns {
      flex-direction: column;
      gap: 8px;
      padding: 10px 0 6px;
    }
    .quotify-add-btn { width: 100% !important; }
    .quotify-view-btn { display: none !important; }
  }
</style>

