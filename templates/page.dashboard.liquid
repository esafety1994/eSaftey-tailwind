{% comment %}
  Custom B2B Account Dashboard — Orders view
  Uses Liquid customer object for auth + data (no OAuth needed)
  Layout: keeps theme header, hides theme footer, fits viewport
{% endcomment %}

{%- if customer == blank -%}
  <script>
    (function() {
      var origin = window.location.origin;
      var dashPath = "/pages/dashboard?view=dashboard";
      var absoluteReturn = encodeURIComponent(origin + dashPath);
      var relativeReturn = encodeURIComponent(dashPath);
      window.location.href = "/account/login?return_url=" + absoluteReturn + "&checkout_url=" + relativeReturn;
    })();
  </script>
  <noscript>Please <a href="/account/login">log in</a> to view your dashboard.</noscript>
{%- else -%}

{%- assign customer_tags_lower = customer.tags | join: ',' | downcase -%}
{%- assign is_b2b = false -%}
{%- if customer_tags_lower contains 'b2b' -%}
  {%- assign is_b2b = true -%}
{%- elsif customer.company != blank -%}
  {%- assign is_b2b = true -%}
{%- elsif customer.company_available_locations.size > 0 -%}
  {%- assign is_b2b = true -%}
{%- endif -%}
{%- unless is_b2b -%}
  <script>
    (function() {
      var KEY = 'esa_dash_d2c_redirected_at';
      var now = Date.now();
      var last = parseInt(sessionStorage.getItem(KEY) || '0', 10);
      if (now - last < 5000) {
        sessionStorage.removeItem(KEY);
        return;
      }
      sessionStorage.setItem(KEY, String(now));
      window.location.replace("/account");
    })();
  </script>
  <noscript>This dashboard is only available for B2B customers. <a href="/account">Go to your account</a>.</noscript>
  <div style="min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;text-align:center;font-family:'Poppins',sans-serif;">
    <h1 style="font-size:24px;margin:0 0 12px;">This dashboard is for B2B customers only</h1>
    <p style="color:#555;margin:0 0 24px;max-width:520px;line-height:1.5;">
      Your account is a standard customer account. You can continue shopping or contact our team for help.
    </p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
      <a href="/collections/all" style="padding:12px 24px;background:#FEEB06;color:#000;border-radius:8px;text-decoration:none;font-weight:700;">Continue shopping</a>
      <a href="/pages/contact-us" style="padding:12px 24px;background:#fff;color:#000;border:1px solid #000;border-radius:8px;text-decoration:none;font-weight:700;">Contact us</a>
    </div>
  </div>
{%- else -%}

{%- comment -%} Compute order counts by status {%- endcomment -%}
{%- assign total_orders = customer.orders.size -%}
{%- assign pending_count = 0 -%}
{%- assign delivered_count = 0 -%}
{%- assign cancelled_count = 0 -%}
{%- for o in customer.orders -%}
  {%- if o.cancelled -%}
    {%- assign cancelled_count = cancelled_count | plus: 1 -%}
  {%- elsif o.fulfillment_status == 'fulfilled' -%}
    {%- assign delivered_count = delivered_count | plus: 1 -%}
  {%- else -%}
    {%- assign pending_count = pending_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="esa-dashboard">
  <aside class="esa-sidebar">
    <div class="esa-sidebar-logo">
      <img src="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/esafetyLogo_colour-01_61b349fd-fe32-4179-a9cd-a72cc46c79b0.png?v=1787109016" alt="eSafety Supplies" class="esa-sidebar-logo-img" width="180" height="28">
    </div>
    <nav class="esa-sidebar-nav">
      <a href="/pages/dashboard?view=dashboard" class="esa-nav-item esa-nav-active">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <span>Orders</span>
      </a>
      <a href="/pages/profile?view=profile" class="esa-nav-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Profile</span>
      </a>
      <a href="/" class="esa-nav-item">
        <svg width="31" height="27" viewBox="0 0 31 27" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><rect width="31" height="27" fill="url(#esa_icon_btw)"/><defs><pattern id="esa_icon_btw" patternContentUnits="objectBoundingBox" width="1" height="1"><use xlink:href="#esa_img_btw" transform="matrix(0.0062212 0 0 0.00714286 -0.000806452 0)"/></pattern><image id="esa_img_btw" width="161" height="140" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/></defs></svg>
        <span>Back to Website</span>
      </a>
    </nav>
    <div class="esa-sidebar-help">
      <div class="esa-help-inner">
        <div class="esa-help-icon">
          <svg viewBox="0 0 29 28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10a11 11 0 0 1 22 0v4a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3h2"/><path d="M3 14a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3H6"/><path d="M14 20a4 4 0 0 0 4-4"/></svg>
        </div>
        <div>
          <div class="esa-help-title">Need help?</div>
          <div class="esa-help-sub">Our team is here to help.</div>
        </div>
      </div>
      <a href="/pages/contact-us" class="esa-help-btn">
        Contact Us
        <svg viewBox="0 0 14 14" fill="none" width="12" height="12"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </aside>

  <main class="esa-main">
    <header class="esa-header">
      <a href="/" class="esa-header-back" aria-label="Back to website">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      </a>
      <div class="esa-header-logo">
        <a href="/" aria-label="Back to eSafety Supplies">
          <img src="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/Advantage_Logo_1-2.png?v=1789450482" alt="eSafety Advantage" width="279" height="44">
        </a>
      </div>
      <div class="esa-header-user esa-user-menu">
        <button type="button" class="esa-user-btn" id="esa-user-btn" aria-haspopup="true" aria-expanded="false" aria-label="Open profile menu">
          {%- if customer.company -%}
          <span class="esa-company-name">{{ customer.company.name }}</span>
          <svg class="esa-caret" viewBox="0 0 10 6" fill="none" width="12" height="12"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- endif -%}
          <div class="esa-avatar">
            {{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}
          </div>
        </button>
        <div class="esa-user-dropdown" id="esa-user-dropdown">
          <a href="/pages/profile?view=profile" class="esa-user-dropdown-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Profile
          </a>
          <a href="/account/logout" class="esa-user-dropdown-item esa-user-dropdown-signout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </a>
        </div>
      </div>
    </header>

    <section class="esa-content">
      <div id="esa-view-orders">
      <div class="esa-welcome">
        <div>
          <h1 class="esa-title">Welcome back! <span class="esa-wave">&#128075;</span></h1>
          <p class="esa-subtitle">View and manage your eSafety Supplies orders all in one place.</p>
        </div>
        <div class="esa-controls">
          <label class="esa-search" for="esa-search-input">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="esa-search-input" placeholder="Search orders, products or PO number..." autocomplete="off" autocorrect="off" spellcheck="false">
          </label>
          <button type="button" class="esa-filters-btn">
            <svg viewBox="0 0 18 13" fill="none" width="18" height="13"><path d="M0 1h18M1.5 6.5h15M5 12h8" stroke="currentColor" stroke-width="2.06" stroke-linecap="round"/></svg>
            Filters
          </button>
        </div>
      </div>

      <div class="esa-callouts">
        <div class="esa-callout esa-callout--dark">
          <div class="esa-callout-rings" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <div class="esa-callout-content">
            <div class="esa-callout-copy">
              <div class="esa-callout-eyebrow">FREIGHT MADE SIMPLE</div>
              <h2 class="esa-callout-heading">Flat freight.<br><span class="esa-callout-heading-accent">No guesswork.</span></h2>
              <p class="esa-callout-body">Know your freight upfront and quote faster on NSW, QLD and VIC metro account orders.</p>
            </div>
            <a href="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/ESS_Freight_Flyer_A4.pdf?v=1794982510" target="_blank" class="esa-callout-cta esa-callout-cta--yellow">
              View freight rates
              <svg viewBox="0 0 14 14" fill="none" width="10" height="10"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="esa-callout-graphic">
            <div class="esa-callout-glow"></div>
            <div class="esa-callout-badge esa-callout-badge--yellow">
              <svg viewBox="0 0 75 68" fill="none" stroke="#000" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" width="62" height="56"><rect x="2" y="17" width="51" height="37" rx="4"/><path d="M53 29h12l8 11v11H53V29z"/><circle cx="17" cy="58" r="8"/><circle cx="62" cy="58" r="8"/></svg>
            </div>
            <div class="esa-callout-chip esa-callout-chip--top"><b>$59 +GST</b>&nbsp;Standard orders</div>
            <div class="esa-callout-chip esa-callout-chip--bottom"><b>$129 +GST</b>&nbsp;Up to 2 pallets</div>
          </div>
        </div>

        <div class="esa-callout esa-callout--yellow">
          <div class="esa-callout-rings esa-callout-rings--dark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <div class="esa-callout-content">
            <div class="esa-callout-copy">
              <div class="esa-callout-eyebrow esa-callout-eyebrow--dark">ADVANTAGE POINTS</div>
              <h2 class="esa-callout-heading esa-callout-heading--dark">Earn points.<br>Redeem rewards.</h2>
              <p class="esa-callout-body esa-callout-body--dark">Check your points balance and redeem your rewards, right here in your dashboard.</p>
            </div>
            <a href="mailto:advantage@esafetysupplies.com.au?subject=eSafety%20Advantage%20-%20Check%20Balance%20%2F%20Redeem%20Points&body=Hi%2C%0A%0AI%27d%20like%20to%20check%2Fredeem%20my%20eSafety%20Advantage%20points" class="esa-callout-cta esa-callout-cta--dark">
              Check &amp; redeem points
              <svg viewBox="0 0 14 14" fill="none" width="10" height="10"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="esa-callout-graphic">
            <div class="esa-callout-glow esa-callout-glow--dark"></div>
            <div class="esa-callout-badge esa-callout-badge--dark">
              <svg viewBox="0 0 50 47" fill="none" stroke="#FEEB06" stroke-width="2.38" stroke-linecap="round" stroke-linejoin="round" width="52" height="47"><rect x="3" y="22" width="44" height="22" rx="3"/><path d="M3 22h44"/><path d="M25 22V44"/><path d="M25 10c0-4-3-7-7-7s-5 4-5 7 2 5 5 5h7V10z"/><path d="M25 10c0-4 3-7 7-7s5 4 5 7-2 5-5 5h-7V10z"/></svg>
            </div>
            <div class="esa-callout-chip esa-callout-chip--top"><b>Check</b>&nbsp;your balance</div>
            <div class="esa-callout-chip esa-callout-chip--bottom"><b>Redeem</b>&nbsp;for rewards</div>
          </div>
        </div>
      </div>

      <div class="esa-recent-header">
        <div>
          <h2 class="esa-section-title">Recent Orders</h2>
          <p class="esa-subtitle">Your latest orders with eSafety Supplies.</p>
        </div>
      </div>

      <div class="esa-orders">
        {%- if customer.orders.size == 0 -%}
          <div class="esa-empty">
            You have no recent orders. <a href="/collections/all">Go Shopping</a>
          </div>
        {%- else -%}
          {%- for order in customer.orders limit: 4 -%}
            {%- assign status_label = 'Processing' -%}
            {%- assign status_class = 'esa-badge-pending' -%}
            {%- if order.cancelled -%}
              {%- assign status_label = 'Cancelled' -%}
              {%- assign status_class = 'esa-badge-cancelled' -%}
            {%- elsif order.fulfillment_status == 'fulfilled' -%}
              {%- assign status_label = 'Completed' -%}
              {%- assign status_class = 'esa-badge-completed' -%}
            {%- endif -%}
            {%- assign po_number = order.note | default: order.name -%}
            {%- if order.attributes['PO Number'] != blank -%}
              {%- assign po_number = order.attributes['PO Number'] -%}
            {%- endif -%}
            <div class="esa-order">
              <div class="esa-order-img">
                {%- assign first_item = order.line_items.first -%}
                {%- if first_item and first_item.image != blank -%}
                  <img src="{{ first_item.image | image_url: width: 200 }}" alt="{{ first_item.title }}" width="200" height="200" loading="lazy">
                {%- else -%}
                  <div class="esa-order-img-placeholder"></div>
                {%- endif -%}
              </div>
              <div class="esa-order-body">
                <div class="esa-order-header">
                  <span class="esa-badge {{ status_class }}">
                    {%- if status_label == 'Cancelled' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    {%- elsif status_label == 'Completed' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- endif -%}
                    {{ status_label }}
                  </span>
                </div>
                <div class="esa-order-title">
                  {%- if po_number != order.name -%}PO #{{ po_number }}{%- else -%}{{ order.name }}{%- endif -%}
                </div>
                {%- if order.line_items.first -%}
                <div class="esa-order-product">{{ order.line_items.first.title }}{%- if order.item_count > 1 %} <span>+{{ order.item_count | minus: 1 }} more</span>{%- endif -%}</div>
                {%- endif -%}
                <div class="esa-order-company">
                  {%- if customer.company -%}{{ customer.company.name }}{%- endif -%}
                </div>
                <div class="esa-order-meta">
                  <div class="esa-meta-block">
                    <span class="esa-meta-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      Date
                    </span>
                    <span class="esa-meta-value">{{ order.created_at | date: '%-d %b %Y' }}</span>
                  </div>
                  <div class="esa-meta-block">
                    <span class="esa-meta-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
                      Total
                    </span>
                    <span class="esa-meta-value">{{ order.total_price | money_with_currency }}</span>
                  </div>
                  <div class="esa-meta-block">
                    <span class="esa-meta-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                      Items
                    </span>
                    <span class="esa-meta-value">{{ order.item_count }} item{% if order.item_count > 1 %}s{% endif %}</span>
                  </div>
                </div>
              </div>
              <div class="esa-order-actions">
                <a href="#" class="esa-view-link esa-view-details-btn" data-order-id="{{ order.id }}">
                  View details
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                {%- capture reorder_items -%}[{%- assign rc = 0 -%}{%- for li in order.line_items -%}{%- unless li.product.tags contains 'excludes_reorder' -%}{%- if rc > 0 -%},{%- endif -%}{"id":{{ li.variant_id }},"quantity":{{ li.quantity }}}{%- assign rc = rc | plus: 1 -%}{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                <button type="button" class="esa-buy-again esa-reorder-btn" data-items='{{ reorder_items }}'>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  Buy again
                </button>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      </div>{%- comment -%} end #esa-view-orders {%- endcomment -%}

      <div id="esa-view-order-detail" style="display:none;">
        <button type="button" class="esa-back-btn" id="esa-back-to-orders">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Orders
        </button>

        {%- for order in customer.orders -%}
          {%- assign d_status_label = 'Processing' -%}
          {%- assign d_status_class = 'esa-badge-pending' -%}
          {%- if order.cancelled -%}
            {%- assign d_status_label = 'Cancelled' -%}
            {%- assign d_status_class = 'esa-badge-cancelled' -%}
          {%- elsif order.fulfillment_status == 'fulfilled' -%}
            {%- assign d_status_label = 'Completed' -%}
            {%- assign d_status_class = 'esa-badge-completed' -%}
          {%- endif -%}
          {%- assign d_po = order.note | default: order.name -%}
          {%- if order.attributes['PO Number'] != blank -%}
            {%- assign d_po = order.attributes['PO Number'] -%}
          {%- endif -%}
          <div class="esa-order-detail" data-order-id="{{ order.id }}" style="display:none;">
            <div class="esa-detail-header">
              <div>
                <span class="esa-badge {{ d_status_class }}">{{ d_status_label }}</span>
                <h2 class="esa-detail-title">
                  {%- if d_po != order.name -%}PO #{{ d_po }}{%- else -%}Order {{ order.name }}{%- endif -%}
                </h2>
                <div class="esa-detail-sub">
                  Placed on {{ order.created_at | date: '%-d %b %Y' }}
                  {%- if customer.company -%} &middot; {{ customer.company.name }}{%- endif -%}
                </div>
              </div>
            </div>

            <div class="esa-detail-grid">
              <div class="esa-detail-card">
                <div class="esa-detail-card-head">Items ({{ order.item_count }})</div>
                <div class="esa-detail-items">
                  {%- for li in order.line_items -%}
                    <div class="esa-detail-line">
                      <div class="esa-detail-line-img">
                        {%- if li.image != blank -%}
                          <img src="{{ li.image | image_url: width: 120 }}" alt="{{ li.title }}" width="60" height="60" loading="lazy">
                        {%- endif -%}
                      </div>
                      <div class="esa-detail-line-body">
                        <div class="esa-detail-line-title">{{ li.title }}</div>
                        {%- if li.variant.title != 'Default Title' -%}
                          <div class="esa-detail-line-variant">{{ li.variant.title }}</div>
                        {%- endif -%}
                        <div class="esa-detail-line-qty">Qty: {{ li.quantity }}</div>
                      </div>
                      <div class="esa-detail-line-price">{{ li.final_line_price | money }}</div>
                    </div>
                  {%- endfor -%}
                </div>
                <div class="esa-detail-totals">
                  <div class="esa-detail-totals-row">
                    <span>Subtotal</span>
                    <span>{{ order.subtotal_price | money }}</span>
                  </div>
                  {%- if order.shipping_price > 0 -%}
                    <div class="esa-detail-totals-row">
                      <span>Shipping</span>
                      <span>{{ order.shipping_price | money }}</span>
                    </div>
                  {%- endif -%}
                  {%- if order.tax_price > 0 -%}
                    <div class="esa-detail-totals-row">
                      <span>Tax</span>
                      <span>{{ order.tax_price | money }}</span>
                    </div>
                  {%- endif -%}
                  <div class="esa-detail-totals-row esa-detail-totals-total">
                    <span>Total</span>
                    <span>{{ order.total_price | money_with_currency }}</span>
                  </div>
                </div>
              </div>

              <div class="esa-detail-side">
                {%- if order.shipping_address -%}
                  <div class="esa-detail-card">
                    <div class="esa-detail-card-head">Shipping address</div>
                    <div class="esa-detail-addr">{{ order.shipping_address | format_address }}</div>
                  </div>
                {%- endif -%}
                {%- if order.billing_address and order.billing_address != order.shipping_address -%}
                  <div class="esa-detail-card">
                    <div class="esa-detail-card-head">Billing address</div>
                    <div class="esa-detail-addr">{{ order.billing_address | format_address }}</div>
                  </div>
                {%- endif -%}
                <div class="esa-detail-card">
                  <div class="esa-detail-card-head">Order summary</div>
                  <div class="esa-detail-summary-row">
                    <span>Order</span><span>{{ order.name }}</span>
                  </div>
                  <div class="esa-detail-summary-row">
                    <span>Financial status</span><span>{{ order.financial_status_label }}</span>
                  </div>
                  <div class="esa-detail-summary-row">
                    <span>Fulfillment</span><span>{{ order.fulfillment_status_label | default: 'Unfulfilled' }}</span>
                  </div>
                </div>
                {%- capture detail_reorder_items -%}[{%- assign drc = 0 -%}{%- for li in order.line_items -%}{%- unless li.product.tags contains 'excludes_reorder' -%}{%- if drc > 0 -%},{%- endif -%}{"id":{{ li.variant_id }},"quantity":{{ li.quantity }}}{%- assign drc = drc | plus: 1 -%}{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                <button type="button" class="esa-yellow-btn-block esa-reorder-btn" data-items='{{ detail_reorder_items }}'>Reorder all items</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>
    <footer class="esa-dash-footer">
      <div class="esa-dash-footer-links">
        <a href="/policies/refund-policy">Refund policy</a>
        <span class="esa-dash-footer-sep">|</span>
        <a href="/policies/shipping-policy">Shipping</a>
        <span class="esa-dash-footer-sep">|</span>
        <a href="/policies/privacy-policy">Privacy policy</a>
        <span class="esa-dash-footer-sep">|</span>
        <a href="/policies/terms-of-service">Terms of service</a>
        <span class="esa-dash-footer-sep">|</span>
        <a href="/pages/contact-us">Contact Information</a>
      </div>
      <div class="esa-dash-footer-strip"></div>
    </footer>
  </main>
</div>

<!-- ===== MOBILE LAYOUT ===== -->
<div class="esa-mob">
  <header class="esa-mob-header">
    <button class="esa-mob-menu-btn" aria-label="Menu">
      <span></span><span></span><span class="esa-mob-menu-short"></span>
    </button>
    <div class="esa-mob-header-logo">
      <img src="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/Advantage_Logo_1-2.png?v=1789450482" alt="eSafety Advantage" height="26" width="166">
    </div>
    <div class="esa-mob-avatar">
      {{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}
    </div>
  </header>

  {%- if customer.company -%}
  <div class="esa-mob-company">
    <span>{{ customer.company.name }}</span>
    <svg viewBox="0 0 10 6" fill="none" width="10" height="6"><path d="M1 1l4 4 4-4" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
  {%- endif -%}

  <div class="esa-mob-content">
    <div id="esa-mob-view-orders">
      <div class="esa-mob-welcome">
        <h1>Welcome back! <span class="esa-wave">&#128075;</span></h1>
        <p>View and manage your eSafety Supplies orders all in one place.</p>
      </div>

      <div class="esa-mob-search-row">
        <label class="esa-mob-search" for="esa-mob-search-input">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" id="esa-mob-search-input" placeholder="Search orders, products or PO..." autocomplete="off" autocorrect="off" spellcheck="false">
        </label>
        <button class="esa-mob-filter-btn" aria-label="Filters">
          <svg viewBox="0 0 18 13" fill="none" width="18" height="13"><path d="M0 1h18M1.5 6.5h15M5 12h8" stroke="currentColor" stroke-width="2.06" stroke-linecap="round"/></svg>
        </button>
      </div>

      <div class="esa-mob-callouts">
        <div class="esa-mob-callout esa-mob-callout--dark">
          <div class="esa-mob-callout-rings" aria-hidden="true"></div>
          <div class="esa-mob-callout-badge esa-mob-callout-badge--yellow">
            <svg viewBox="0 0 75 68" fill="none" stroke="#000" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" width="52" height="47"><rect x="2" y="17" width="51" height="37" rx="4"/><path d="M53 29h12l8 11v11H53V29z"/><circle cx="17" cy="58" r="8"/><circle cx="62" cy="58" r="8"/></svg>
          </div>
          <div class="esa-mob-callout-body">
            <div class="esa-mob-callout-eyebrow">FREIGHT MADE SIMPLE</div>
            <h2 class="esa-mob-callout-heading">Flat freight.<br><span>No guesswork.</span></h2>
            <a href="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/ESS_Freight_Flyer_A4.pdf?v=1794982510" target="_blank" class="esa-mob-callout-cta esa-mob-callout-cta--yellow">
              View freight rates
              <svg viewBox="0 0 14 14" fill="none" width="10" height="10"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="esa-mob-callout esa-mob-callout--yellow">
          <div class="esa-mob-callout-rings esa-mob-callout-rings--dark" aria-hidden="true"></div>
          <div class="esa-mob-callout-badge esa-mob-callout-badge--dark">
            <svg viewBox="0 0 50 47" fill="none" stroke="#FEEB06" stroke-width="2.38" stroke-linecap="round" stroke-linejoin="round" width="44" height="40"><rect x="3" y="22" width="44" height="22" rx="3"/><path d="M3 22h44"/><path d="M25 22V44"/><path d="M25 10c0-4-3-7-7-7s-5 4-5 7 2 5 5 5h7V10z"/><path d="M25 10c0-4 3-7 7-7s5 4 5 7-2 5-5 5h-7V10z"/></svg>
          </div>
          <div class="esa-mob-callout-body">
            <div class="esa-mob-callout-eyebrow esa-mob-callout-eyebrow--dark">ADVANTAGE POINTS</div>
            <h2 class="esa-mob-callout-heading esa-mob-callout-heading--dark">Earn points.<br>Redeem rewards.</h2>
            <a href="mailto:advantage@esafetysupplies.com.au?subject=eSafety%20Advantage%20-%20Check%20Balance%20%2F%20Redeem%20Points&body=Hi%2C%0A%0AI%27d%20like%20to%20check%2Fredeem%20my%20eSafety%20Advantage%20points" class="esa-mob-callout-cta esa-mob-callout-cta--dark">
              Check &amp; redeem points
              <svg viewBox="0 0 14 14" fill="none" width="10" height="10"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="esa-mob-stats-grid">
        <div class="esa-mob-stat esa-mob-stat--active">
          <div class="esa-mob-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <div class="esa-mob-stat-text">
            <div class="esa-mob-stat-label">Total Orders</div>
            <div class="esa-mob-stat-value">{{ total_orders }}</div>
          </div>
        </div>
        <div class="esa-mob-stat">
          <div class="esa-mob-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div class="esa-mob-stat-text">
            <div class="esa-mob-stat-label">Pending / Processing</div>
            <div class="esa-mob-stat-value">{{ pending_count }}</div>
          </div>
        </div>
        <div class="esa-mob-stat">
          <div class="esa-mob-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div class="esa-mob-stat-text">
            <div class="esa-mob-stat-label">Delivered</div>
            <div class="esa-mob-stat-value">{{ delivered_count }}</div>
          </div>
        </div>
        <div class="esa-mob-stat">
          <div class="esa-mob-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <div class="esa-mob-stat-text">
            <div class="esa-mob-stat-label">Cancelled</div>
            <div class="esa-mob-stat-value">{{ cancelled_count }}</div>
          </div>
        </div>
      </div>

      <div class="esa-mob-orders-section">
        <div class="esa-mob-section-head">
          <h2>Recent Orders</h2>
          <p>Your latest orders with eSafety Supplies.</p>
        </div>
        <div class="esa-mob-sort-row">
          <span class="esa-mob-sort-label">Sort by</span>
          <div class="esa-mob-sort-box">
            Most recent
            <svg viewBox="0 0 10 6" fill="none" width="10" height="6"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
        </div>

        {%- if customer.orders.size == 0 -%}
          <div class="esa-mob-empty">
            You have no recent orders. <a href="/collections/all">Go Shopping</a>
          </div>
        {%- else -%}
          {%- for order in customer.orders limit: 4 -%}
            {%- assign m_status_label = 'Processing' -%}
            {%- assign m_status_class = 'esa-badge-pending' -%}
            {%- if order.cancelled -%}
              {%- assign m_status_label = 'Cancelled' -%}
              {%- assign m_status_class = 'esa-badge-cancelled' -%}
            {%- elsif order.fulfillment_status == 'fulfilled' -%}
              {%- assign m_status_label = 'Completed' -%}
              {%- assign m_status_class = 'esa-badge-completed' -%}
            {%- endif -%}
            {%- assign m_po = order.note | default: order.name -%}
            {%- if order.attributes['PO Number'] != blank -%}
              {%- assign m_po = order.attributes['PO Number'] -%}
            {%- endif -%}
            <div class="esa-mob-order">
              <div class="esa-mob-order-top">
                <span class="esa-badge {{ m_status_class }}">{{ m_status_label }}</span>
                <span class="esa-mob-order-name">{%- if m_po != order.name -%}PO #{{ m_po }}{%- else -%}{{ order.name }}{%- endif -%}</span>
              </div>
              {%- if order.line_items.first -%}
              <div class="esa-mob-order-product">{{ order.line_items.first.title }}{%- if order.item_count > 1 %} <span>+{{ order.item_count | minus: 1 }} more</span>{%- endif -%}</div>
              {%- endif -%}
              <div class="esa-mob-order-meta">
                <span>{{ order.created_at | date: '%-d %b %Y' }}</span>
                <span>{{ order.total_price | money_with_currency }}</span>
                <span>{{ order.item_count }} item{% if order.item_count > 1 %}s{% endif %}</span>
              </div>
              <div class="esa-mob-order-actions">
                <button type="button" class="esa-mob-view-btn esa-mob-view-details-btn" data-order-id="{{ order.id }}">View details</button>
                {%- capture mob_reorder -%}[{%- assign mrc = 0 -%}{%- for li in order.line_items -%}{%- unless li.product.tags contains 'excludes_reorder' -%}{%- if mrc > 0 -%},{%- endif -%}{"id":{{ li.variant_id }},"quantity":{{ li.quantity }}}{%- assign mrc = mrc | plus: 1 -%}{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                <button type="button" class="esa-mob-reorder-btn esa-reorder-btn" data-items='{{ mob_reorder }}'>Buy again</button>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="esa-mob-help">
        <div class="esa-mob-help-row">
          <svg viewBox="0 0 29 28" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="29" height="28"><path d="M3 10a11 11 0 0 1 22 0v4a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3h2"/><path d="M3 14a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3H6"/><path d="M14 20a4 4 0 0 0 4-4"/></svg>
          <div>
            <div class="esa-mob-help-title">Need help?</div>
            <div class="esa-mob-help-sub">Our team is here to help.</div>
          </div>
        </div>
        <a href="/pages/contact-us" class="esa-mob-help-btn">
          Contact Us
          <svg viewBox="0 0 14 14" fill="none" width="10" height="10"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <footer class="esa-mob-footer">
        <div class="esa-mob-footer-links">
          <a href="/policies/refund-policy">Refund policy</a>
          <a href="/policies/shipping-policy">Shipping</a>
          <a href="/policies/privacy-policy">Privacy policy</a>
          <a href="/policies/terms-of-service">Terms of service</a>
          <a href="/pages/contact-us">Contact Information</a>
        </div>
        <div class="esa-mob-footer-strip"></div>
      </footer>

    </div>

    <div id="esa-mob-view-detail" style="display:none;">
      <button type="button" class="esa-mob-back-btn" id="esa-mob-back-to-orders">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Orders
      </button>
      {%- for order in customer.orders -%}
        {%- assign md_status_label = 'Processing' -%}
        {%- assign md_status_class = 'esa-badge-pending' -%}
        {%- if order.cancelled -%}
          {%- assign md_status_label = 'Cancelled' -%}
          {%- assign md_status_class = 'esa-badge-cancelled' -%}
        {%- elsif order.fulfillment_status == 'fulfilled' -%}
          {%- assign md_status_label = 'Completed' -%}
          {%- assign md_status_class = 'esa-badge-completed' -%}
        {%- endif -%}
        {%- assign md_po = order.note | default: order.name -%}
        {%- if order.attributes['PO Number'] != blank -%}
          {%- assign md_po = order.attributes['PO Number'] -%}
        {%- endif -%}
        <div class="esa-mob-detail-panel" data-order-id="{{ order.id }}" style="display:none;">
          <span class="esa-badge {{ md_status_class }}">{{ md_status_label }}</span>
          <h2 class="esa-mob-detail-title">{%- if md_po != order.name -%}PO #{{ md_po }}{%- else -%}Order {{ order.name }}{%- endif -%}</h2>
          <p class="esa-mob-detail-sub">Placed on {{ order.created_at | date: '%-d %b %Y' }}{%- if customer.company -%} &middot; {{ customer.company.name }}{%- endif -%}</p>

          <div class="esa-mob-detail-card">
            <div class="esa-mob-detail-card-head">Items ({{ order.item_count }})</div>
            {%- for li in order.line_items -%}
              <div class="esa-mob-detail-line">
                <div class="esa-mob-detail-line-img">
                  {%- if li.image != blank -%}<img src="{{ li.image | image_url: width: 120 }}" alt="{{ li.title }}" width="60" height="60" loading="lazy">{%- endif -%}
                </div>
                <div class="esa-mob-detail-line-body">
                  <div class="esa-mob-detail-line-title">{{ li.title }}</div>
                  {%- if li.variant.title != 'Default Title' -%}<div class="esa-mob-detail-line-variant">{{ li.variant.title }}</div>{%- endif -%}
                  <div class="esa-mob-detail-line-qty">Qty: {{ li.quantity }}</div>
                </div>
                <div class="esa-mob-detail-line-price">{{ li.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
            <div class="esa-mob-detail-totals">
              <div class="esa-mob-detail-totals-row"><span>Subtotal</span><span>{{ order.subtotal_price | money }}</span></div>
              {%- if order.shipping_price > 0 -%}<div class="esa-mob-detail-totals-row"><span>Shipping</span><span>{{ order.shipping_price | money }}</span></div>{%- endif -%}
              {%- if order.tax_price > 0 -%}<div class="esa-mob-detail-totals-row"><span>Tax</span><span>{{ order.tax_price | money }}</span></div>{%- endif -%}
              <div class="esa-mob-detail-totals-row esa-mob-detail-totals-total"><span>Total</span><span>{{ order.total_price | money_with_currency }}</span></div>
            </div>
          </div>

          {%- if order.shipping_address -%}
          <div class="esa-mob-detail-card">
            <div class="esa-mob-detail-card-head">Shipping address</div>
            <div class="esa-mob-detail-addr">{{ order.shipping_address | format_address }}</div>
          </div>
          {%- endif -%}

          <div class="esa-mob-detail-card">
            <div class="esa-mob-detail-card-head">Order summary</div>
            <div class="esa-mob-detail-summary-row"><span>Order</span><span>{{ order.name }}</span></div>
            <div class="esa-mob-detail-summary-row"><span>Financial status</span><span>{{ order.financial_status_label }}</span></div>
            <div class="esa-mob-detail-summary-row"><span>Fulfillment</span><span>{{ order.fulfillment_status_label | default: 'Unfulfilled' }}</span></div>
          </div>

          {%- capture md_reorder -%}[{%- assign mdrc = 0 -%}{%- for li in order.line_items -%}{%- unless li.product.tags contains 'excludes_reorder' -%}{%- if mdrc > 0 -%},{%- endif -%}{"id":{{ li.variant_id }},"quantity":{{ li.quantity }}}{%- assign mdrc = mdrc | plus: 1 -%}{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
          <button type="button" class="esa-yellow-btn-block esa-reorder-btn" data-items='{{ md_reorder }}'>Reorder all items</button>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <nav class="esa-mob-bottom-nav">
    <a href="/pages/dashboard?view=dashboard" class="esa-mob-nav-item esa-mob-nav-active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
      Orders
    </a>
    <a href="/pages/profile?view=profile" class="esa-mob-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Profile
    </a>
    <a href="/" class="esa-mob-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      Back to Website
    </a>
  </nav>
</div>

<style>
.esa-dashboard {
  font-family: 'Poppins', sans-serif;
  display: flex;
  min-height: 70vh;
  background: #F7F8F9;
  color: #000;
  margin: 0;
}

/* Hide site header + site footer on desktop dashboard */
@media (min-width: 901px) {
  body > .sticky { display: none !important; }
  body > footer { display: none !important; }
  .esa-dashboard { min-height: 100vh; }
}

/* Sidebar */
.esa-sidebar {
  width: 268px;
  min-width: 268px;
  background: #0D0D0D;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  color: #fff;
}
.esa-sidebar-logo {
  padding: 8px 12px 24px;
  display: flex;
  justify-content: center;
}
.esa-sidebar-logo-img { width: 190px; height: auto; display: block; }
.esa-sidebar-brand { color: #fff; font-weight: 700; font-size: 16px; }
.esa-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}
.esa-nav-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 20px;
  border-radius: 15px;
  color: #fff;
  font-weight: 500;
  font-size: 16px;
  text-decoration: none;
  transition: background 0.15s;
}
.esa-nav-item svg { width: 24px; height: 24px; }
.esa-nav-item:hover { background: #16161A; }
.esa-nav-active {
  background: #FEEB06;
  color: #000;
}
.esa-nav-active:hover { background: #FEEB06; }
.esa-sidebar-help {
  background: #16161A;
  border-radius: 15px;
  padding: 16px;
}
.esa-help-inner {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.esa-help-icon {
  width: 40px; height: 40px;
  background: #0D0D0D;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #FEEB06;
  flex-shrink: 0;
}
.esa-help-icon svg { width: 20px; height: 20px; }
.esa-help-title {
  color: #fff; font-weight: 500; font-size: 15px;
}
.esa-help-sub {
  color: #ccc; font-size: 11px;
}
.esa-help-btn {
  display: flex; align-items: center; justify-content: center;
  gap: 8px;
  background: #FEEB06; color: #000;
  padding: 12px 20px;
  border-radius: 15px;
  font-weight: 500;
  text-decoration: none;
  font-size: 14px;
}
.esa-help-btn svg { width: 14px; height: 14px; }
.esa-help-btn:hover { background: #FEEB06; color: #000; }

/* Main */
.esa-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 100vh;
}

.esa-header {
  height: 78px;
  flex-shrink: 0;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40px;
  gap: 12px;
}
.esa-header-back {
  display: none;
}
.esa-header-back svg { width: 22px; height: 22px; }
.esa-header-logo {
  flex: 1;
  display: flex;
  justify-content: center;
}
.esa-header-logo a { display: block; text-decoration: none; }
.esa-header-user { flex-shrink: 0; }
.esa-header-logo img {
  height: 44px;
  width: auto;
  display: block;
}
.esa-header-user {
  position: relative;
  display: flex; align-items: center; gap: 12px;
}
.esa-user-btn {
  display: flex; align-items: center; gap: 12px;
  background: transparent; border: none;
  padding: 6px 8px; border-radius: 8px;
  cursor: pointer; font-family: inherit;
}
.esa-user-btn:hover { background: rgba(255,255,255,0.08); }
.esa-company-name {
  font-weight: 600; font-size: 16px; color: #fff;
}
.esa-caret { width: 14px; height: 14px; color: #fff; transition: transform 0.2s; }
.esa-user-menu.is-open .esa-caret { transform: rotate(180deg); }
.esa-avatar {
  width: 42px; height: 42px;
  background: #FEEB06;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 20px;
  color: #000;
}
.esa-user-dropdown {
  position: absolute; top: 100%; right: 0; margin-top: 8px;
  background: #fff; border: 1px solid #EFF0F2;
  border-radius: 12px; box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.08);
  min-width: 200px; padding: 8px;
  display: none; z-index: 100;
}
.esa-user-menu.is-open .esa-user-dropdown { display: block; }
.esa-user-dropdown-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 8px;
  color: #000; text-decoration: none;
  font-size: 14px; font-weight: 500;
}
.esa-user-dropdown-item:hover { background: #F7F8F9; }
.esa-user-dropdown-item svg { width: 16px; height: 16px; }
.esa-user-dropdown-signout { color: #C11414; }
.esa-user-dropdown-signout:hover { background: #FFECEC; }

/* Content */
.esa-content {
  padding: 32px 48px 48px;
  flex: 1;
  width: 100%;
}
.esa-content::-webkit-scrollbar { width: 10px; }
.esa-content::-webkit-scrollbar-track { background: #E9EAEE; border-radius: 5px; }
.esa-content::-webkit-scrollbar-thumb { background: #999; border-radius: 5px; }
.esa-content::-webkit-scrollbar-thumb:hover { background: #666; }
.esa-welcome {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 32px;
  margin-bottom: 28px;
}
.esa-title {
  font-size: 30px;
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 6px;
  letter-spacing: -0.005em;
}
.esa-wave { display: inline-block; }
.esa-subtitle {
  font-size: 15px;
  color: #555;
  margin: 0;
  line-height: 1.5;
  letter-spacing: -0.01em;
}
.esa-controls {
  display: flex; gap: 12px; flex-shrink: 0;
}
.esa-search {
  display: flex; align-items: center; gap: 10px;
  background: #fff; border: 1px solid #D9D9D9;
  border-radius: 9px;
  padding: 0 18px;
  width: 426px; max-width: 100%;
  height: 50px;
}
.esa-search svg { width: 18px; height: 18px; color: #000; flex-shrink: 0; }
.esa-search input {
  border: none; outline: none; background: transparent;
  width: 100%; font-family: inherit; font-size: 15px;
  color: #000;
}
.esa-filters-btn {
  display: flex; align-items: center; justify-content: center;
  gap: 10px;
  background: #fff; border: 1px solid #D9D9D9;
  border-radius: 9px;
  padding: 0 20px; height: 50px;
  font-family: inherit;
  font-weight: 700; font-size: 15px;
  color: #000; cursor: pointer;
}
.esa-filters-btn svg { width: 18px; height: 18px; }

.esa-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}
.esa-stat {
  background: #fff; border: 1px solid #EFF0F2;
  border-radius: 12px;
  padding: 16px;
  display: flex; align-items: center; gap: 14px;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.03);
}
.esa-stat-active { background: #FEEB06; border-color: #FEEB06; }
.esa-stat-active .esa-stat-icon { background: #FDF7AA; }
.esa-stat-icon {
  width: 52px; height: 52px; border-radius: 50%;
  background: #EFF0F2;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.esa-stat-icon svg { width: 22px; height: 22px; color: #000; }
.esa-stat-label {
  font-size: 13px; font-weight: 500;
  margin-bottom: 2px;
  letter-spacing: -0.01em;
}
.esa-stat-value {
  font-size: 26px; font-weight: 700; line-height: 1;
  letter-spacing: -0.02em;
}

/* Desktop marketing callouts */
.esa-callouts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 32px;
}
.esa-callout {
  position: relative;
  border-radius: 16px;
  min-height: 241px;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 28px 32px;
  gap: 0;
}
.esa-callout--dark { background: #0D0D0D; }
.esa-callout--yellow { background: #FEEB06; }
.esa-callout-rings {
  position: absolute;
  right: -102px; top: -70px;
  width: 424px; height: 424px;
  pointer-events: none;
}
.esa-callout-rings span {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 1.5px solid;
}
.esa-callout-rings span:nth-child(1) { width: 184px; height: 184px; border-color: rgba(254,235,6,0.22); }
.esa-callout-rings span:nth-child(2) { width: 264px; height: 264px; border-color: rgba(254,235,6,0.14); }
.esa-callout-rings span:nth-child(3) { width: 344px; height: 344px; border-color: rgba(254,235,6,0.09); }
.esa-callout-rings span:nth-child(4) { width: 424px; height: 424px; border-color: rgba(254,235,6,0.05); }
.esa-callout-rings--dark span:nth-child(1) { border-color: rgba(0,0,0,0.12); }
.esa-callout-rings--dark span:nth-child(2) { border-color: rgba(0,0,0,0.08); }
.esa-callout-rings--dark span:nth-child(3) { border-color: rgba(0,0,0,0.055); }
.esa-callout-rings--dark span:nth-child(4) { border-color: rgba(0,0,0,0.035); }
.esa-callout-content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
  position: relative;
  z-index: 1;
  min-width: 0;
}
.esa-callout-copy { display: flex; flex-direction: column; gap: 8px; }
.esa-callout-eyebrow {
  font-size: 12px; font-weight: 600;
  letter-spacing: 0.1em; color: #FEEB06;
}
.esa-callout-eyebrow--dark { color: #000; }
.esa-callout-heading {
  font-size: 28px; font-weight: 700;
  letter-spacing: -0.01em; line-height: 112%;
  margin: 0; color: #fff;
}
.esa-callout-heading--dark { color: #000; }
.esa-callout-heading-accent { color: #FEEB06; }
.esa-callout-body {
  font-size: 15px; font-weight: 400;
  letter-spacing: -0.01em; line-height: 1.5;
  color: rgba(255,255,255,0.78); margin: 0;
}
.esa-callout-body--dark { color: rgba(0,0,0,0.78); }
.esa-callout-cta {
  display: inline-flex; align-items: center;
  gap: 10px; padding: 10px 24px;
  border-radius: 15px; font-weight: 500;
  font-size: 14px; text-decoration: none;
  align-self: flex-start;
}
.esa-callout-cta--yellow { background: #FEEB06; color: #000; }
.esa-callout-cta--dark { background: #0D0D0D; color: #FEEB06; }
.esa-callout-graphic {
  position: relative;
  width: 220px; min-width: 220px; height: 185px;
  margin-left: 12px;
}
.esa-callout-glow {
  position: absolute;
  width: 156px; height: 156px;
  right: 0; top: 15px;
  background: rgba(254,235,6,0.18); border-radius: 50%;
}
.esa-callout-glow--dark { background: rgba(13,13,13,0.12); }
.esa-callout-badge {
  position: absolute;
  width: 128px; height: 128px;
  right: 14px; top: 29px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.esa-callout-badge--yellow { background: #FEEB06; }
.esa-callout-badge--dark { background: #0D0D0D; }
.esa-callout-chip {
  position: absolute;
  display: flex; align-items: center;
  padding: 7px 14px;
  background: #fff;
  box-shadow: 0px 6px 16px rgba(0,0,0,0.16);
  border-radius: 999px;
  font-size: 13px; font-weight: 500;
  letter-spacing: -0.01em; color: #000;
  white-space: nowrap; z-index: 1;
}
.esa-callout-chip--top { top: 16px; left: 0; }
.esa-callout-chip--bottom { bottom: 16px; left: 24px; }

.esa-recent-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 20px;
}
.esa-section-title {
  font-size: 27.5px; font-weight: 700;
  line-height: 1.15;
  margin: 0 0 4px;
  letter-spacing: -0.005em;
}
.esa-sort {
  display: flex; align-items: center; gap: 12px;
}
.esa-sort-label {
  font-size: 15.5px; color: #000;
  letter-spacing: -0.032em;
}
.esa-sort-box {
  display: flex; align-items: center; gap: 12px;
  background: #fff; border: 1px solid #D9D9D9;
  border-radius: 10px;
  padding: 10px 16px; height: 43px;
  font-weight: 600; font-size: 14px;
  cursor: pointer;
}
.esa-sort-box svg { width: 12px; height: 12px; }

.esa-orders { display: flex; flex-direction: column; gap: 16px; }
.esa-empty {
  padding: 24px;
  color: #000; font-size: 16px;
}
.esa-empty a { color: #005bd3; text-decoration: underline; }

.esa-order {
  background: #fff; border: 1px solid #EFF0F2;
  border-radius: 12px;
  padding: 14px;
  display: flex; gap: 14px;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.03);
}
.esa-order-img {
  width: 90px; height: 90px; flex-shrink: 0;
  border-radius: 8px;
  border: 1px solid #EFF0F2;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  background: #F7F8F9;
}
.esa-order-img img { width: 100%; height: 100%; object-fit: contain; }
.esa-order-img-placeholder { width: 100%; height: 100%; background: #EFF0F2; }
.esa-order-body { flex: 1; min-width: 0; }
.esa-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 10px;
  border-radius: 100px;
  font-weight: 700; font-size: 11px;
}
.esa-badge svg { width: 12px; height: 12px; }
.esa-badge-completed { background: #E7FFED; color: #007A2F; }
.esa-badge-pending { background: #FFF6DD; color: #7A5F00; }
.esa-badge-cancelled { background: #FFECEC; color: #C11414; }

.esa-order-title { font-size: 16px; font-weight: 700; margin-top: 6px; }
.esa-order-product { font-size: 12.5px; font-weight: 500; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
.esa-order-product span { color: #999; font-weight: 400; }
.esa-order-company { font-size: 12px; color: #666; margin-bottom: 8px; }
.esa-order-meta {
  display: flex; gap: 28px; margin-top: 4px;
}
.esa-meta-block { display: flex; flex-direction: column; gap: 3px; }
.esa-meta-label {
  display: flex; align-items: center; gap: 4px;
  font-size: 11px; color: #666;
}
.esa-meta-label svg { width: 12px; height: 12px; }
.esa-meta-value { font-weight: 700; font-size: 13px; }

.esa-order-actions {
  display: flex; flex-direction: column; align-items: flex-end;
  justify-content: space-between;
  gap: 20px; flex-shrink: 0;
}
.esa-view-link {
  display: inline-flex; align-items: center; gap: 6px;
  color: #000; text-decoration: underline;
  font-weight: 500; font-size: 14px;
}
.esa-view-link svg { width: 14px; height: 14px; }
.esa-buy-again-form { margin: 0; }
.esa-buy-again {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 20px;
  border: 1px solid #000;
  border-radius: 100px;
  background: #fff; color: #000;
  font-family: inherit;
  font-weight: 500; font-size: 14px;
  cursor: pointer;
}
.esa-buy-again svg { width: 14px; height: 14px; }
.esa-buy-again:hover { background: #000; color: #fff; }

/* Order detail view */
.esa-back-btn {
  display: inline-flex; align-items: center; gap: 6px;
  background: transparent; border: none;
  font-family: inherit; font-size: 14px; font-weight: 500; color: #000;
  cursor: pointer; padding: 0 0 20px;
}
.esa-back-btn svg { width: 16px; height: 16px; }
.esa-back-btn:hover { text-decoration: underline; }

.esa-detail-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 20px; margin-bottom: 24px;
}
.esa-detail-title { font-size: 28px; font-weight: 700; margin: 8px 0 4px; letter-spacing: -0.005em; }
.esa-detail-sub { font-size: 14px; color: #555; }
.esa-outline-btn-sm {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 14px; background: #fff;
  border: 1px solid #1E1E1E; border-radius: 8px;
  font-family: inherit; font-weight: 600; font-size: 12px;
  color: #000; text-decoration: none;
}
.esa-outline-btn-sm:hover { background: #f7f7f7; }

.esa-detail-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
}
.esa-detail-side { display: flex; flex-direction: column; gap: 16px; }
.esa-detail-card {
  background: #fff; border: 1px solid #EFF0F2;
  border-radius: 12px; padding: 20px;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.03);
}
.esa-detail-card-head {
  font-weight: 700; font-size: 14px; margin-bottom: 14px;
  letter-spacing: 0.04em;
}
.esa-detail-items { display: flex; flex-direction: column; gap: 12px; }
.esa-detail-line {
  display: flex; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid #EFF0F2;
}
.esa-detail-line:last-child { border-bottom: none; }
.esa-detail-line-img {
  width: 60px; height: 60px; flex-shrink: 0;
  border: 1px solid #EFF0F2; border-radius: 6px;
  overflow: hidden; background: #F7F8F9;
  display: flex; align-items: center; justify-content: center;
}
.esa-detail-line-img img { width: 100%; height: 100%; object-fit: contain; }
.esa-detail-line-body { flex: 1; min-width: 0; }
.esa-detail-line-title { font-size: 14px; font-weight: 600; }
.esa-detail-line-variant { font-size: 12px; color: #666; margin-top: 2px; }
.esa-detail-line-qty { font-size: 12px; color: #666; margin-top: 4px; }
.esa-detail-line-price { font-weight: 700; font-size: 14px; flex-shrink: 0; }

.esa-detail-totals {
  margin-top: 16px; padding-top: 16px;
  border-top: 1px solid #EFF0F2;
}
.esa-detail-totals-row {
  display: flex; justify-content: space-between;
  font-size: 13px; padding: 4px 0;
}
.esa-detail-totals-total {
  font-weight: 700; font-size: 16px;
  padding-top: 8px; margin-top: 8px;
  border-top: 1px solid #EFF0F2;
}
.esa-detail-addr { font-size: 13px; line-height: 1.6; color: #333; }
.esa-detail-summary-row {
  display: flex; justify-content: space-between;
  font-size: 13px; padding: 6px 0;
  border-bottom: 1px solid #F5F5F5;
}
.esa-detail-summary-row:last-child { border-bottom: none; }
.esa-detail-summary-row span:first-child { color: #666; }
.esa-detail-summary-row span:last-child { font-weight: 600; }
.esa-detail-reorder { margin-top: 4px; }
.esa-yellow-btn-block {
  display: block; width: 100%;
  background: #FEEB06; color: #000;
  padding: 12px 20px; border: none; border-radius: 11px;
  font-family: inherit; font-weight: 700; font-size: 14px;
  cursor: pointer;
}
.esa-yellow-btn-block:hover { background: #f5d900; }

/* Desktop dashboard footer */
.esa-dash-footer {
  flex-shrink: 0;
}
.esa-dash-footer-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px 0;
  padding: 18px 48px;
  background: #E9EAEE;
}
.esa-dash-footer-links a {
  font-size: 13.5px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: #000;
  text-decoration: none;
  padding: 0 14px;
}
.esa-dash-footer-links a:first-child { padding-left: 0; }
.esa-dash-footer-links a:hover { text-decoration: underline; }
.esa-dash-footer-sep { color: #000; font-size: 13.5px; }
.esa-dash-footer-strip { height: 8px; background: #FEEB06; }

/* ===== MOBILE STYLES ===== */
.esa-mob {
  display: none;
  flex-direction: column;
  min-height: 100vh;
  background: #F7F8F9;
  font-family: 'Poppins', sans-serif;
  color: #000;
  padding-bottom: 90px;
}

@media (max-width: 900px) {
  .esa-dashboard { display: none !important; }
  .esa-mob { display: flex !important; }
  body > footer { display: none !important; }
}

.esa-mob-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16px;
  height: 64px;
  background: #000;
}
.esa-mob-header-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.esa-mob-header-logo img { display: block; height: 26px; width: auto; }
.esa-mob-header {
  position: relative;
  flex-shrink: 0;
}
.esa-mob-menu-btn {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.esa-mob-menu-btn span {
  display: block;
  width: 22px;
  height: 2.4px;
  background: #fff;
  border-radius: 2px;
}
.esa-mob-menu-short { width: 16px !important; }
.esa-mob-avatar {
  width: 34px;
  height: 34px;
  background: #FEEB06;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 15px;
  color: #000;
}

.esa-mob-company {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0 16px;
  gap: 8px;
  height: 42px;
  background: #fff;
  flex-shrink: 0;
}
.esa-mob-company span { font-weight: 600; font-size: 13px; }

.esa-mob-content {
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding: 20px 16px;
  flex: 1;
}
#esa-mob-view-orders {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.esa-mob-welcome h1 {
  font-size: 25px;
  font-weight: 700;
  letter-spacing: -0.005em;
  margin: 0 0 4px;
  line-height: 1.52;
}
.esa-mob-welcome p {
  font-size: 12.5px;
  letter-spacing: -0.032em;
  margin: 0;
  line-height: 1.52;
}

.esa-mob-search-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.esa-mob-search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 14px;
  height: 46px;
  background: #fff;
  border: 1px solid #E9EAEE;
  border-radius: 10px;
  cursor: text;
}
.esa-mob-search input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-size: 12px;
  font-weight: 500;
  color: #000;
  font-family: inherit;
  min-width: 0;
}
.esa-mob-search input::placeholder { color: #999; font-weight: 400; }
.esa-mob-filter-btn {
  width: 46px;
  height: 46px;
  background: #fff;
  border: 1px solid #E9EAEE;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
