.esa-detail-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
}
.esa-detail-side { display: flex; flex-direction: column; gap: 16px; }
.esa-detail-card {
  background: #fff; border: 1px solid #EFF0F2;
