}
.esa-detail-line-img img { width: 100%; height: 100%; object-fit: contain; }
.esa-detail-line-body { flex: 1; min-width: 0; }
.esa-detail-line-title { font-size: 14px; font-weight: 600; }
.esa-detail-line-variant { font-size: 12px; color: #666; margin-top: 2px; }
.esa-detail-line-qty { font-size: 12px; color: #666; margin-top: 4px; }
.esa-detail-line-price { font-weight: 700; font-size: 14px; flex-shrink: 0; }

.esa-detail-totals {
  margin-top: 16px; padding-top: 16px;
  border-top: 1px solid #EFF0F2;
}
.esa-detail-totals-row {
  display: flex; justify-content: space-between;
  font-size: 13px; padding: 4px 0;
}
.esa-detail-totals-total {
  font-weight: 700; font-size: 16px;
  padding-top: 8px; margin-top: 8px;
  border-top: 1px solid #EFF0F2;
}
.esa-detail-addr { font-size: 13px; line-height: 1.6; color: #333; }
.esa-detail-summary-row {
  display: flex; justify-content: space-between;
  font-size: 13px; padding: 6px 0;
  border-bottom: 1px solid #F5F5F5;
}
.esa-detail-summary-row:last-child { border-bottom: none; }
.esa-detail-summary-row span:first-child { color: #666; }
.esa-detail-summary-row span:last-child { font-weight: 600; }
.esa-detail-reorder { margin-top: 4px; }
.esa-yellow-btn-block {
  display: block; width: 100%;
  background: #FEEB06; color: #000;
  padding: 12px 20px; border: none; border-radius: 11px;
  font-family: inherit; font-weight: 700; font-size: 14px;
  cursor: pointer;
}
.esa-yellow-btn-block:hover { background: #f5d900; }

@media (max-width: 900px) {
  .esa-dashboard { flex-direction: column; }
  .esa-sidebar { width: 100%; }
  .esa-header { padding: 0 20px; }
  .esa-content { padding: 20px; }
  .esa-welcome { flex-direction: column; }
  .esa-controls { width: 100%; }
  .esa-search { width: 100%; }
  .esa-stats { grid-template-columns: repeat(2, 1fr); }
  .esa-order { flex-direction: column; }
  .esa-order-img { width: 100%; height: 180px; }
  .esa-order-actions { flex-direction: row; align-items: center; justify-content: space-between; }
  .esa-detail-grid { grid-template-columns: 1fr; }
}
</style>

<script>
(function() {
  document.documentElement.classList.add('esa-dashboard-active');
  document.body.classList.add('esa-dashboard-active');
  function resizeDashboard() {
    var dashboard = document.querySelector('.esa-dashboard');
    if (!dashboard) return;
    var rect = dashboard.getBoundingClientRect();
    var offsetTop = rect.top + window.scrollY;
    var newHeight = window.innerHeight - offsetTop;
    dashboard.style.height = Math.max(newHeight, 400) + 'px';
  }
  resizeDashboard();
  window.addEventListener('resize', resizeDashboard);
  window.addEventListener('load', function() {
    setTimeout(resizeDashboard, 100);
    setTimeout(resizeDashboard, 500);
  });

  // View switching: orders list <-> order detail
  var ordersView = document.getElementById('esa-view-orders');
  var detailView = document.getElementById('esa-view-order-detail');
  var content = document.querySelector('.esa-content');

  function showDetail(orderId) {
    if (!ordersView || !detailView) return;
    ordersView.style.display = 'none';
    detailView.style.display = 'block';
    var details = detailView.querySelectorAll('.esa-order-detail');
    details.forEach(function(d) { d.style.display = 'none'; });
    var target = detailView.querySelector('.esa-order-detail[data-order-id="' + orderId + '"]');
    if (target) target.style.display = 'block';
    if (content) content.scrollTop = 0;
  }

  function showList() {
    if (!ordersView || !detailView) return;
    detailView.style.display = 'none';
    ordersView.style.display = 'block';
    if (content) content.scrollTop = 0;
  }

  document.querySelectorAll('.esa-view-details-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      showDetail(btn.dataset.orderId);
    });
  });
  var backBtn = document.getElementById('esa-back-to-orders');
  if (backBtn) backBtn.addEventListener('click', showList);

  // User menu dropdown
  var userBtn = document.getElementById('esa-user-btn');
  var userMenu = document.querySelector('.esa-user-menu');
  if (userBtn && userMenu) {
    userBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      userMenu.classList.toggle('is-open');
      userBtn.setAttribute('aria-expanded', userMenu.classList.contains('is-open'));
    });
    document.addEventListener('click', function(e) {
      if (!userMenu.contains(e.target)) {
        userMenu.classList.remove('is-open');
        userBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Buy again / Reorder — add all order items to cart via AJAX + open cart drawer
  document.querySelectorAll('.esa-reorder-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var items;
      try { items = JSON.parse(btn.dataset.items || '[]'); }
      catch (err) { items = []; }
      if (!items.length) return;
      var originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          items: items,
          sections: 'esaftey-cart-drawer,cart-count'
        })
      })
      .then(function(r) {
        if (!r.ok) return r.json().then(function(err) { throw err; });
        return r.json();
      })
      .then(function(data) {
        btn.disabled = false;
        btn.innerHTML = originalText;
        // Trigger cart drawer to re-render with new items and open
        try {
          document.documentElement.dispatchEvent(new CustomEvent('cart:render', { detail: data, bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:render', { detail: data, bubbles: true }));
        } catch(err) {}
        if (typeof window.openCartDrawer === 'function') {
          try { window.openCartDrawer(); } catch(err) {}
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = originalText;
        var msg = (err && err.description) ? err.description : 'Some items could not be added to the cart.';
        alert(msg);
      });
    });
  });
})();
</script>

{%- endunless -%}
{%- endif -%}
