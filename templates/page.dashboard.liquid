<script>
(function() {
  // View switching: orders list <-> order detail
  var ordersView = document.getElementById('esa-view-orders');
  var detailView = document.getElementById('esa-view-order-detail');
  var content = document.querySelector('.esa-content');

  function showDetail(orderId) {
    if (!ordersView || !detailView) return;
    ordersView.style.display = 'none';
    detailView.style.display = 'block';
    var details = detailView.querySelectorAll('.esa-order-detail');
    details.forEach(function(d) { d.style.display = 'none'; });
    var target = detailView.querySelector('.esa-order-detail[data-order-id="' + orderId + '"]');
    if (target) target.style.display = 'block';
    if (content) content.scrollTop = 0;
  }

  function showList() {
    if (!ordersView || !detailView) return;
    detailView.style.display = 'none';
    ordersView.style.display = 'block';
    if (content) content.scrollTop = 0;
  }

  document.querySelectorAll('.esa-view-details-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      showDetail(btn.dataset.orderId);
    });
  });
  var backBtn = document.getElementById('esa-back-to-orders');
  if (backBtn) backBtn.addEventListener('click', showList);

  var deskSearch = document.getElementById('esa-search-input');
  if (deskSearch) {
    deskSearch.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      document.querySelectorAll('#esa-view-orders .esa-order').forEach(function(card) {
        card.style.display = (!q || card.textContent.toLowerCase().indexOf(q) !== -1) ? '' : 'none';
      });
    });
  }


  // User menu dropdown
  var userBtn = document.getElementById('esa-user-btn');
  var userMenu = document.querySelector('.esa-user-menu');
  if (userBtn && userMenu) {
    userBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      userMenu.classList.toggle('is-open');
      userBtn.setAttribute('aria-expanded', userMenu.classList.contains('is-open'));
    });
    document.addEventListener('click', function(e) {
      if (!userMenu.contains(e.target)) {
        userMenu.classList.remove('is-open');
        userBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Buy again / Reorder — add order items to cart with per-item fallback so
  // eligible items still land even if the batch is rejected (e.g. one item is
  // gated by a promo eligibility rule or out of stock).
  document.querySelectorAll('.esa-reorder-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var items;
      try { items = JSON.parse(btn.dataset.items || '[]'); }
      catch (err) { items = []; }
      if (!items.length) {
        alert('This order only contains promotional items that can\'t be reordered here. Please contact support if you need help.');
        return;
      }
      var originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      function post(payload) {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
      }
      function openCart(data) {
        try {
          document.documentElement.dispatchEvent(new CustomEvent('cart:render', { detail: data, bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:render', { detail: data, bubbles: true }));
        } catch(err) {}
        if (typeof window.openCartDrawer === 'function') {
          try { window.openCartDrawer(); } catch(err) {}
        }
      }
      function reset() { btn.disabled = false; btn.innerHTML = originalText; }

      function retryIndividually() {
        var successes = 0;
        var failures = [];
        var lastData = null;
        var chain = Promise.resolve();
        items.forEach(function(item) {
          chain = chain.then(function() {
            return post({ items: [item], sections: 'esaftey-cart-drawer,cart-count' })
              .then(function(r) {
                if (r.ok) return r.json().then(function(d) { successes++; lastData = d; });
                return r.json().then(function(err) { failures.push(err); });
              })
              .catch(function() { failures.push(null); });
          });
        });
        return chain.then(function() {
          reset();
          if (lastData) openCart(lastData);
          if (failures.length) {
            var seen = {};
            failures.forEach(function(err) {
              var m = (err && err.description) ? err.description : 'Item unavailable or out of stock';
              seen[m] = true;
            });
            var msgs = Object.keys(seen);
            var summary;
            if (successes > 0) {
              summary = successes + ' of ' + items.length + ' item(s) added to cart.\n\n' +
                        failures.length + ' item(s) could not be added:\n• ' + msgs.join('\n• ');
            } else {
              summary = 'No items could be added to the cart:\n• ' + msgs.join('\n• ') +
                        '\n\nPlease contact support if the issue persists.';
            }
            alert(summary);
          }
        });
      }

      post({ items: items, sections: 'esaftey-cart-drawer,cart-count' })
        .then(function(r) {
          if (r.ok) return r.json().then(function(data) { reset(); openCart(data); });
          return retryIndividually();
        })
        .catch(function() { retryIndividually(); });
    });
  });
})();
</script>

<script>
(function() {
  var mobOrdersView = document.getElementById('esa-mob-view-orders');
  var mobDetailView = document.getElementById('esa-mob-view-detail');
  var mobContent = mobOrdersView && mobOrdersView.closest('.esa-mob-content');

  function mobShowDetail(orderId) {
    if (!mobOrdersView || !mobDetailView) return;
    mobOrdersView.style.display = 'none';
    mobDetailView.style.display = 'block';
    var panels = mobDetailView.querySelectorAll('.esa-mob-detail-panel');
    panels.forEach(function(p) { p.style.display = 'none'; });
    var target = mobDetailView.querySelector('.esa-mob-detail-panel[data-order-id="' + orderId + '"]');
    if (target) target.style.display = 'block';
    if (mobContent) mobContent.scrollTop = 0;
    window.scrollTo(0, 0);
  }

  function mobShowList() {
    if (!mobOrdersView || !mobDetailView) return;
    mobDetailView.style.display = 'none';
    mobOrdersView.style.display = 'block';
    if (mobContent) mobContent.scrollTop = 0;
    window.scrollTo(0, 0);
  }

  document.querySelectorAll('.esa-mob-view-details-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { mobShowDetail(btn.dataset.orderId); });
  });

  var mobBackBtn = document.getElementById('esa-mob-back-to-orders');
  if (mobBackBtn) mobBackBtn.addEventListener('click', mobShowList);

  var mobSearchInput = document.getElementById('esa-mob-search-input');
  if (mobSearchInput) {
    mobSearchInput.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      var cards = document.querySelectorAll('#esa-mob-view-orders .esa-mob-order');
      cards.forEach(function(card) {
        var text = card.textContent.toLowerCase();
        card.style.display = (!q || text.indexOf(q) !== -1) ? '' : 'none';
      });
    });
  }
})();
</script>

