{% comment %}
  Custom B2B Account Dashboard — Orders view
  Uses Liquid customer object for auth + data (no OAuth needed)
  Layout: keeps theme header, hides theme footer, fits viewport
{% endcomment %}

{%- if customer == blank -%}
  <script>
    (function() {
      var origin = window.location.origin;
      var dashPath = "/pages/dashboard?view=dashboard";
      var absoluteReturn = encodeURIComponent(origin + dashPath);
      var relativeReturn = encodeURIComponent(dashPath);
      window.location.href = "/account/login?return_url=" + absoluteReturn + "&checkout_url=" + relativeReturn;
    })();
  </script>
  <noscript>Please <a href="/account/login">log in</a> to view your dashboard.</noscript>
{%- else -%}

{%- assign customer_tags_lower = customer.tags | join: ',' | downcase -%}
{%- assign is_b2b = false -%}
{%- if customer_tags_lower contains 'b2b' -%}
  {%- assign is_b2b = true -%}
{%- elsif customer.company != blank -%}
  {%- assign is_b2b = true -%}
{%- elsif customer.company_available_locations.size > 0 -%}
  {%- assign is_b2b = true -%}
{%- endif -%}
{%- unless is_b2b -%}
  <script>window.location.href = "/account";</script>
  <noscript>This dashboard is only available for B2B customers. <a href="/account">Go to your account</a>.</noscript>
{%- else -%}

{%- comment -%} Compute order counts by status {%- endcomment -%}
{%- assign total_orders = customer.orders.size -%}
{%- assign pending_count = 0 -%}
{%- assign delivered_count = 0 -%}
{%- assign cancelled_count = 0 -%}
{%- for o in customer.orders -%}
  {%- if o.cancelled -%}
    {%- assign cancelled_count = cancelled_count | plus: 1 -%}
  {%- elsif o.fulfillment_status == 'fulfilled' -%}
    {%- assign delivered_count = delivered_count | plus: 1 -%}
  {%- else -%}
    {%- assign pending_count = pending_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="esa-dashboard">
  <aside class="esa-sidebar">
    <nav class="esa-sidebar-nav">
      <a href="/pages/dashboard" class="esa-nav-item esa-nav-active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <span>Orders</span>
      </a>
      <a href="/pages/profile?view=profile" class="esa-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Profile</span>
      </a>
      <a href="/" class="esa-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span>Back to Website</span>
      </a>
    </nav>
    <div class="esa-sidebar-help">
      <div class="esa-help-inner">
        <div class="esa-help-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3v4zM3 19a2 2 0 0 0 2 2h1v-6H3v4z"/></svg>
        </div>
        <div>
          <div class="esa-help-title">Need help?</div>
          <div class="esa-help-sub">Our team is here to help.</div>
        </div>
      </div>
      <a href="/pages/contact-us" class="esa-help-btn">
        Contact Us
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </aside>

  <main class="esa-main">
    <header class="esa-header">
      <div class="esa-header-logo">
        <img src="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/Advantage_Logo_2-2.png?v=1785216933" alt="eSafety Advantage" width="279" height="44">
      </div>
      <div class="esa-header-user esa-user-menu">
        <button type="button" class="esa-user-btn" id="esa-user-btn" aria-haspopup="true" aria-expanded="false">
          {%- if customer.company -%}
            <span class="esa-company-name">{{ customer.company.name }}</span>
          {%- else -%}
            <span class="esa-company-name">{{ customer.first_name }} {{ customer.last_name }}</span>
          {%- endif -%}
          <svg class="esa-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          <div class="esa-avatar">
            {{ customer.first_name | slice: 0 | upcase }}
          </div>
        </button>
        <div class="esa-user-dropdown" id="esa-user-dropdown">
          <a href="/pages/profile?view=profile" class="esa-user-dropdown-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Profile
          </a>
          <a href="/account/logout" class="esa-user-dropdown-item esa-user-dropdown-signout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </a>
        </div>
      </div>
    </header>

    <section class="esa-content">
      <div id="esa-view-orders">
      <div class="esa-welcome">
        <div>
          <h1 class="esa-title">Welcome back! <span class="esa-wave">&#128075;</span></h1>
          <p class="esa-subtitle">View and manage your eSafety Supplies orders all in one place.</p>
        </div>
        <div class="esa-controls">
          <div class="esa-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="Search orders, products or PO number..." id="esa-search-input">
          </div>
          <button class="esa-filters-btn" id="esa-filters-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" y1="6" x2="3" y2="6"/><line x1="17" y1="12" x2="7" y2="12"/><line x1="14" y1="18" x2="10" y2="18"/></svg>
            Filters
          </button>
        </div>
      </div>

      <div class="esa-stats">
        <div class="esa-stat esa-stat-active">
          <div class="esa-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <div>
            <div class="esa-stat-label">Total Orders</div>
            <div class="esa-stat-value">{{ total_orders }}</div>
          </div>
        </div>
        <div class="esa-stat">
          <div class="esa-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div>
            <div class="esa-stat-label">Pending / Processing</div>
            <div class="esa-stat-value">{{ pending_count }}</div>
          </div>
        </div>
        <div class="esa-stat">
          <div class="esa-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div>
            <div class="esa-stat-label">Delivered</div>
            <div class="esa-stat-value">{{ delivered_count }}</div>
          </div>
        </div>
        <div class="esa-stat">
          <div class="esa-stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <div>
            <div class="esa-stat-label">Cancelled</div>
            <div class="esa-stat-value">{{ cancelled_count }}</div>
          </div>
        </div>
      </div>

      <div class="esa-recent-header">
        <div>
          <h2 class="esa-section-title">Recent Orders</h2>
          <p class="esa-subtitle">Your latest orders with eSafety Supplies.</p>
        </div>
        <div class="esa-sort">
          <span class="esa-sort-label">Sort by</span>
          <div class="esa-sort-box">
            <span>Most recent</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
      </div>

      <div class="esa-orders">
        {%- if customer.orders.size == 0 -%}
          <div class="esa-empty">
            You have no recent orders. <a href="/collections/all">Go Shopping</a>
          </div>
        {%- else -%}
          {%- for order in customer.orders limit: 4 -%}
            {%- assign status_label = 'Processing' -%}
            {%- assign status_class = 'esa-badge-pending' -%}
            {%- if order.cancelled -%}
              {%- assign status_label = 'Cancelled' -%}
              {%- assign status_class = 'esa-badge-cancelled' -%}
            {%- elsif order.fulfillment_status == 'fulfilled' -%}
              {%- assign status_label = 'Completed' -%}
              {%- assign status_class = 'esa-badge-completed' -%}
            {%- endif -%}
            {%- assign po_number = order.note | default: order.name -%}
            {%- if order.attributes['PO Number'] != blank -%}
              {%- assign po_number = order.attributes['PO Number'] -%}
            {%- endif -%}
            <div class="esa-order">
              <div class="esa-order-img">
                {%- assign first_item = order.line_items.first -%}
                {%- if first_item and first_item.image != blank -%}
                  <img src="{{ first_item.image | image_url: width: 200 }}" alt="{{ first_item.title }}" width="200" height="200" loading="lazy">
                {%- else -%}
                  <div class="esa-order-img-placeholder"></div>
                {%- endif -%}
              </div>
              <div class="esa-order-body">
                <div class="esa-order-header">
                  <span class="esa-badge {{ status_class }}">
                    {%- if status_label == 'Cancelled' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    {%- elsif status_label == 'Completed' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- endif -%}
                    {{ status_label }}
                  </span>
                </div>
                <div class="esa-order-title">
                  {%- if po_number != order.name -%}PO #{{ po_number }}{%- else -%}{{ order.name }}{%- endif -%}
                </div>
                <div class="esa-order-company">
                  {%- if customer.company -%}{{ customer.company.name }}{%- endif -%}
                </div>
                <div class="esa-order-meta">
                  <div class="esa-meta-block">
                    <span class="esa-meta-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      Date
                    </span>
                    <span class="esa-meta-value">{{ order.created_at | date: '%-d %b %Y' }}</span>
                  </div>
                  <div class="esa-meta-block">
                    <span class="esa-meta-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
                      Total
                    </span>
                    <span class="esa-meta-value">{{ order.total_price | money_with_currency }}</span>
                  </div>
                  <div class="esa-meta-block">
                    <span class="esa-meta-label">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                      Items
                    </span>
                    <span class="esa-meta-value">{{ order.item_count }} item{% if order.item_count > 1 %}s{% endif %}</span>
                  </div>
                </div>
              </div>
              <div class="esa-order-actions">
                <a href="#" class="esa-view-link esa-view-details-btn" data-order-id="{{ order.id }}">
                  View details
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                {%- capture reorder_items -%}[{%- for li in order.line_items -%}{"id":{{ li.variant_id }},"quantity":{{ li.quantity }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                <button type="button" class="esa-buy-again esa-reorder-btn" data-items='{{ reorder_items }}'>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  Buy again
                </button>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      </div>{%- comment -%} end #esa-view-orders {%- endcomment -%}

      <div id="esa-view-order-detail" style="display:none;">
        <button type="button" class="esa-back-btn" id="esa-back-to-orders">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Orders
        </button>

        {%- for order in customer.orders -%}
          {%- assign d_status_label = 'Processing' -%}
          {%- assign d_status_class = 'esa-badge-pending' -%}
          {%- if order.cancelled -%}
            {%- assign d_status_label = 'Cancelled' -%}
            {%- assign d_status_class = 'esa-badge-cancelled' -%}
          {%- elsif order.fulfillment_status == 'fulfilled' -%}
            {%- assign d_status_label = 'Completed' -%}
            {%- assign d_status_class = 'esa-badge-completed' -%}
          {%- endif -%}
          {%- assign d_po = order.note | default: order.name -%}
          {%- if order.attributes['PO Number'] != blank -%}
            {%- assign d_po = order.attributes['PO Number'] -%}
          {%- endif -%}
          <div class="esa-order-detail" data-order-id="{{ order.id }}" style="display:none;">
            <div class="esa-detail-header">
              <div>
                <span class="esa-badge {{ d_status_class }}">{{ d_status_label }}</span>
                <h2 class="esa-detail-title">
                  {%- if d_po != order.name -%}PO #{{ d_po }}{%- else -%}Order {{ order.name }}{%- endif -%}
                </h2>
                <div class="esa-detail-sub">
                  Placed on {{ order.created_at | date: '%-d %b %Y' }}
                  {%- if customer.company -%} &middot; {{ customer.company.name }}{%- endif -%}
                </div>
              </div>
              <a href="{{ order.customer_url }}" class="esa-outline-btn-sm" target="_blank" rel="noopener">
                View in Shopify
              </a>
            </div>

            <div class="esa-detail-grid">
              <div class="esa-detail-card">
                <div class="esa-detail-card-head">Items ({{ order.item_count }})</div>
                <div class="esa-detail-items">
                  {%- for li in order.line_items -%}
                    <div class="esa-detail-line">
                      <div class="esa-detail-line-img">
                        {%- if li.image != blank -%}
                          <img src="{{ li.image | image_url: width: 120 }}" alt="{{ li.title }}" width="60" height="60" loading="lazy">
                        {%- endif -%}
                      </div>
                      <div class="esa-detail-line-body">
                        <div class="esa-detail-line-title">{{ li.title }}</div>
                        {%- if li.variant.title != 'Default Title' -%}
                          <div class="esa-detail-line-variant">{{ li.variant.title }}</div>
                        {%- endif -%}
                        <div class="esa-detail-line-qty">Qty: {{ li.quantity }}</div>
                      </div>
                      <div class="esa-detail-line-price">{{ li.final_line_price | money }}</div>
                    </div>
                  {%- endfor -%}
                </div>
                <div class="esa-detail-totals">
                  <div class="esa-detail-totals-row">
                    <span>Subtotal</span>
                    <span>{{ order.subtotal_price | money }}</span>
                  </div>
                  {%- if order.shipping_price > 0 -%}
                    <div class="esa-detail-totals-row">
                      <span>Shipping</span>
                      <span>{{ order.shipping_price | money }}</span>
                    </div>
                  {%- endif -%}
                  {%- if order.tax_price > 0 -%}
                    <div class="esa-detail-totals-row">
                      <span>Tax</span>
                      <span>{{ order.tax_price | money }}</span>
                    </div>
                  {%- endif -%}
                  <div class="esa-detail-totals-row esa-detail-totals-total">
                    <span>Total</span>
                    <span>{{ order.total_price | money_with_currency }}</span>
                  </div>
                </div>
              </div>

              <div class="esa-detail-side">
                {%- if order.shipping_address -%}
                  <div class="esa-detail-card">
                    <div class="esa-detail-card-head">Shipping address</div>
                    <div class="esa-detail-addr">{{ order.shipping_address | format_address }}</div>
                  </div>
                {%- endif -%}
                {%- if order.billing_address and order.billing_address != order.shipping_address -%}
                  <div class="esa-detail-card">
                    <div class="esa-detail-card-head">Billing address</div>
                    <div class="esa-detail-addr">{{ order.billing_address | format_address }}</div>
                  </div>
                {%- endif -%}
                <div class="esa-detail-card">
                  <div class="esa-detail-card-head">Order summary</div>
                  <div class="esa-detail-summary-row">
                    <span>Order</span><span>{{ order.name }}</span>
                  </div>
                  <div class="esa-detail-summary-row">
                    <span>Financial status</span><span>{{ order.financial_status_label }}</span>
                  </div>
                  <div class="esa-detail-summary-row">
                    <span>Fulfillment</span><span>{{ order.fulfillment_status_label | default: 'Unfulfilled' }}</span>
                  </div>
                </div>
                {%- capture detail_reorder_items -%}[{%- for li in order.line_items -%}{"id":{{ li.variant_id }},"quantity":{{ li.quantity }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                <button type="button" class="esa-yellow-btn-block esa-reorder-btn" data-items='{{ detail_reorder_items }}'>Reorder all items</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>
  </main>
</div>

<style>
/* Hide theme footer + prevent page scroll for dashboard */
html.esa-dashboard-active,
body.esa-dashboard-active {
  overflow: hidden !important;
  height: 100vh !important;
  margin: 0 !important;
  padding: 0 !important;
}
body.esa-dashboard-active footer,
body.esa-dashboard-active .footer,
body.esa-dashboard-active .site-footer,
body.esa-dashboard-active #footer,
body.esa-dashboard-active [class*="site-footer"],
body.esa-dashboard-active [id*="shopify-section-footer"],
body.esa-dashboard-active [class*="promo-popup"],
body.esa-dashboard-active [id*="shopify-section-promo"] { display: none !important; }
/* Common feedback/help widgets */
body.esa-dashboard-active [class*="feedback"],
body.esa-dashboard-active [id*="feedback"] { display: none !important; }

.esa-dashboard {
  font-family: 'Poppins', sans-serif;
  display: flex;
  height: 100vh; /* JS will override with dynamic value */
  background: #F7F8F9;
  color: #000;
  margin: 0;
  overflow: hidden;
}

/* Sidebar */
.esa-sidebar {
  width: 240px;
  min-width: 240px;
  background: #0D0D0D;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  color: #fff;
  height: 100%;
  overflow: hidden;
}
.esa-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}
.esa-nav-item {
  display: flex;
