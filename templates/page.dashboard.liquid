  letter-spacing: 0.04em;
}
.esa-detail-items { display: flex; flex-direction: column; gap: 12px; }
.esa-detail-line {
  display: flex; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid #EFF0F2;
}
.esa-detail-line:last-child { border-bottom: none; }
.esa-detail-line-img {
  width: 60px; height: 60px; flex-shrink: 0;
  border: 1px solid #EFF0F2; border-radius: 6px;
  overflow: hidden; background: #F7F8F9;
