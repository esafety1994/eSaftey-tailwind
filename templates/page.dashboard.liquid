}
.esa-detail-title { font-size: 28px; font-weight: 700; margin: 8px 0 4px; letter-spacing: -0.005em; }
.esa-detail-sub { font-size: 14px; color: #555; }
.esa-outline-btn-sm {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 14px; background: #fff;
  border: 1px solid #1E1E1E; border-radius: 8px;
