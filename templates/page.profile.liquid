{% comment %}
  Custom B2B Account Profile page
  Uses Liquid customer object for auth + data
  Layout: keeps theme header, hides theme footer, fits viewport
{% endcomment %}

{%- if customer == blank -%}
  <script>window.location.href = "/account/login?return_to=/pages/profile";</script>
  <noscript>Please <a href="/account/login">log in</a> to view your profile.</noscript>
{%- else -%}

{%- assign customer_tags_lower = customer.tags | join: ',' | downcase -%}
{%- assign is_b2b = false -%}
{%- if customer_tags_lower contains 'b2b' -%}
  {%- assign is_b2b = true -%}
{%- elsif customer.company != blank -%}
  {%- assign is_b2b = true -%}
{%- elsif customer.company_available_locations.size > 0 -%}
  {%- assign is_b2b = true -%}
{%- endif -%}
{%- unless is_b2b -%}
  <script>
    (function() {
      var KEY = 'esa_profile_d2c_redirected_at';
      var now = Date.now();
      var last = parseInt(sessionStorage.getItem(KEY) || '0', 10);
      if (now - last < 5000) {
        sessionStorage.removeItem(KEY);
        return;
      }
      sessionStorage.setItem(KEY, String(now));
      window.location.replace("/account");
    })();
  </script>
  <noscript>This profile is only available for B2B customers. <a href="/account">Go to your account</a>.</noscript>
  <div style="min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;text-align:center;font-family:'Poppins',sans-serif;">
    <h1 style="font-size:24px;margin:0 0 12px;">This profile is for B2B customers only</h1>
    <p style="color:#555;margin:0 0 24px;max-width:520px;line-height:1.5;">
      Your account is a standard customer account. You can continue shopping or contact our team for help.
    </p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
      <a href="/collections/all" style="padding:12px 24px;background:#FEEB06;color:#000;border-radius:8px;text-decoration:none;font-weight:700;">Continue shopping</a>
      <a href="/pages/contact-us" style="padding:12px 24px;background:#fff;color:#000;border:1px solid #000;border-radius:8px;text-decoration:none;font-weight:700;">Contact us</a>
    </div>
  </div>
{%- else -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="esa-dashboard">
  <aside class="esa-sidebar">
    <nav class="esa-sidebar-nav">
      <a href="/pages/dashboard?view=dashboard" class="esa-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <span>Orders</span>
      </a>
    </nav>
  </aside>

  <main class="esa-main">
    <header class="esa-header">
      <a href="/pages/dashboard?view=dashboard" class="esa-header-back" aria-label="Back to orders">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      </a>
      <div class="esa-header-logo">
        <a href="/" aria-label="Back to eSafety Supplies">
          <img src="https://cdn.shopify.com/s/files/1/0638/5175/7736/files/Advantage_Logo_2-2.png?v=1785216933" alt="eSafety Advantage" width="279" height="44">
        </a>
      </div>
      <div class="esa-header-user esa-user-menu">
        <button type="button" class="esa-user-btn" id="esa-user-btn" aria-haspopup="true" aria-expanded="false" aria-label="Open profile menu">
          <div class="esa-avatar">
            {{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}
          </div>
        </button>
        <div class="esa-user-dropdown" id="esa-user-dropdown">
          <a href="/pages/profile?view=profile" class="esa-user-dropdown-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Profile
          </a>
          <a href="/account/logout" class="esa-user-dropdown-item esa-user-dropdown-signout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </a>
        </div>
      </div>
    </header>

    <section class="esa-content">
      <div class="esa-welcome">
        <div>
          <div class="esa-breadcrumb">
            <a href="/pages/dashboard?view=dashboard">Home</a> <span>/</span> <span>Profile</span>
          </div>
          <h1 class="esa-title">Profile</h1>
          <p class="esa-subtitle">View and manage your account preferences.</p>
        </div>
      </div>

      <div class="esa-profile-grid">
        <div class="esa-card esa-card-personal">
          <div class="esa-card-head">
            <div class="esa-card-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <div>
                <div class="esa-card-heading">Personal Details</div>
                <div class="esa-card-sub">Update the details linked to your account.</div>
              </div>
            </div>
            <button type="button" class="esa-outline-btn" id="esa-edit-details-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Edit details
            </button>
          </div>
          <form id="esa-profile-form" class="esa-form" method="post" action="/account">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <div class="esa-form-row">
              <div class="esa-form-field">
                <label>First name</label>
                <input type="text" name="customer[first_name]" value="{{ customer.first_name }}" readonly>
              </div>
              <div class="esa-form-field">
                <label>Last name</label>
                <input type="text" name="customer[last_name]" value="{{ customer.last_name }}" readonly>
              </div>
            </div>
            <div class="esa-form-field">
              <label>Email</label>
              <input type="email" name="customer[email]" value="{{ customer.email }}" readonly>
            </div>
            <div class="esa-form-field">
              <label>Company</label>
              <input type="text" value="{%- if customer.company -%}{{ customer.company.name }}{%- endif -%}" readonly disabled>
            </div>
            <div class="esa-form-actions" style="display:none;">
              <button type="submit" class="esa-yellow-btn">Save changes</button>
              <button type="button" class="esa-outline-btn" id="esa-cancel-edit">Cancel</button>
            </div>
          </form>
        </div>

        <div class="esa-side-col">
          <div class="esa-card">
            <div class="esa-card-head">
              <div class="esa-card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <div>
                  <div class="esa-card-heading">Addresses</div>
                  <div class="esa-card-sub">Add, edit or remove your saved addresses.</div>
                </div>
              </div>
              <button type="button" class="esa-outline-btn" id="esa-toggle-add-address">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add address
              </button>
            </div>

            <form class="esa-address-form" id="esa-new-address-form" method="post" action="/account/addresses" style="display:none;">
              <input type="hidden" name="form_type" value="customer_address">
              <input type="hidden" name="utf8" value="✓">
              <div class="esa-form-row">
                <div class="esa-form-field">
                  <label>First name</label>
                  <input type="text" name="address[first_name]" value="{{ customer.first_name }}">
                </div>
                <div class="esa-form-field">
                  <label>Last name</label>
                  <input type="text" name="address[last_name]" value="{{ customer.last_name }}">
                </div>
              </div>
              <div class="esa-form-field">
                <label>Company</label>
                <input type="text" name="address[company]" value="{% if customer.company %}{{ customer.company.name }}{% endif %}">
              </div>
              <div class="esa-form-field">
                <label>Address</label>
                <input type="text" name="address[address1]" required>
              </div>
              <div class="esa-form-field">
                <label>Apartment, suite, etc.</label>
                <input type="text" name="address[address2]">
              </div>
              <div class="esa-form-row">
                <div class="esa-form-field">
                  <label>City</label>
                  <input type="text" name="address[city]" required>
                </div>
                <div class="esa-form-field">
                  <label>Postcode</label>
                  <input type="text" name="address[zip]" required>
                </div>
              </div>
              <div class="esa-form-row">
                <div class="esa-form-field">
                  <label>Country</label>
                  <input type="text" name="address[country]" value="Australia" required>
                </div>
                <div class="esa-form-field">
                  <label>State / Province</label>
                  <input type="text" name="address[province]" required>
                </div>
              </div>
              <div class="esa-form-field">
                <label>Phone</label>
                <input type="tel" name="address[phone]">
              </div>
              <div class="esa-form-field-checkbox">
                <label>
                  <input type="checkbox" name="address[default]" value="1">
                  Set as default address
                </label>
              </div>
              <div class="esa-form-actions">
                <button type="submit" class="esa-yellow-btn">Save address</button>
                <button type="button" class="esa-outline-btn esa-cancel-add">Cancel</button>
              </div>
            </form>

            <div class="esa-addresses-list">
              {%- if customer.addresses.size == 0 -%}
                <div class="esa-address-empty">
                  <div class="esa-address-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <div>
                    <div class="esa-address-title">No addresses saved</div>
                    <div class="esa-address-sub">Click "Add address" above to add your first one.</div>
                  </div>
                </div>
              {%- else -%}
                {%- for address in customer.addresses -%}
                  <div class="esa-address-item" data-address-id="{{ address.id }}">
                    <div class="esa-address-view">
                      <div class="esa-address-info">
                        <div class="esa-address-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div>
                          {%- if address == customer.default_address -%}
                            <span class="esa-default-badge">Default</span>
                          {%- endif -%}
                          <div class="esa-address-formatted">{{ address | format_address }}</div>
                        </div>
                      </div>
                      <div class="esa-address-actions">
                        <button type="button" class="esa-icon-btn esa-edit-btn" data-edit-id="{{ address.id }}" aria-label="Edit address">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                        <form method="post" action="/account/addresses/{{ address.id }}" class="esa-delete-form" onsubmit="return confirm('Delete this address?');">
                          <input type="hidden" name="_method" value="delete">
                          <input type="hidden" name="form_type" value="customer_address">
                          <button type="submit" class="esa-icon-btn esa-icon-btn-danger" aria-label="Delete address">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                          </button>
                        </form>
                      </div>
                    </div>
                    <form class="esa-address-form esa-edit-form" id="esa-edit-form-{{ address.id }}" method="post" action="/account/addresses/{{ address.id }}" style="display:none;">
                      <input type="hidden" name="_method" value="put">
                      <input type="hidden" name="form_type" value="customer_address">
                      <input type="hidden" name="utf8" value="✓">
                      <div class="esa-form-row">
                        <div class="esa-form-field">
                          <label>First name</label>
                          <input type="text" name="address[first_name]" value="{{ address.first_name }}">
                        </div>
                        <div class="esa-form-field">
                          <label>Last name</label>
                          <input type="text" name="address[last_name]" value="{{ address.last_name }}">
                        </div>
                      </div>
                      <div class="esa-form-field">
                        <label>Company</label>
                        <input type="text" name="address[company]" value="{{ address.company }}">
                      </div>
                      <div class="esa-form-field">
                        <label>Address</label>
                        <input type="text" name="address[address1]" value="{{ address.address1 }}" required>
                      </div>
                      <div class="esa-form-field">
                        <label>Apartment, suite, etc.</label>
                        <input type="text" name="address[address2]" value="{{ address.address2 }}">
                      </div>
                      <div class="esa-form-row">
                        <div class="esa-form-field">
                          <label>City</label>
                          <input type="text" name="address[city]" value="{{ address.city }}" required>
                        </div>
                        <div class="esa-form-field">
                          <label>Postcode</label>
                          <input type="text" name="address[zip]" value="{{ address.zip }}" required>
                        </div>
                      </div>
                      <div class="esa-form-row">
                        <div class="esa-form-field">
                          <label>Country</label>
                          <input type="text" name="address[country]" value="{{ address.country }}" required>
                        </div>
                        <div class="esa-form-field">
                          <label>State / Province</label>
                          <input type="text" name="address[province]" value="{{ address.province }}" required>
                        </div>
                      </div>
                      <div class="esa-form-field">
                        <label>Phone</label>
                        <input type="tel" name="address[phone]" value="{{ address.phone }}">
                      </div>
                      {%- if address != customer.default_address -%}
                        <div class="esa-form-field-checkbox">
                          <label>
                            <input type="checkbox" name="address[default]" value="1">
                            Set as default address
                          </label>
                        </div>
                      {%- endif -%}
                      <div class="esa-form-actions">
                        <button type="submit" class="esa-yellow-btn">Save changes</button>
                        <button type="button" class="esa-outline-btn esa-cancel-edit-addr" data-cancel-id="{{ address.id }}">Cancel</button>
                      </div>
                    </form>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>

          <div class="esa-signout-form">
            <a href="/account/logout" class="esa-yellow-btn esa-signout-btn">Sign out</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<script>
(function() {
  var editBtn = document.getElementById('esa-edit-details-btn');
  var form = document.getElementById('esa-profile-form');
  if (!editBtn || !form) return;
  var actions = form.querySelector('.esa-form-actions');
  var inputs = form.querySelectorAll('input[type="text"], input[type="email"]');
  var cancelBtn = document.getElementById('esa-cancel-edit');

  function setEditing(on) {
    inputs.forEach(function(i) {
      if (i.disabled) return;
      if (on) { i.removeAttribute('readonly'); }
      else { i.setAttribute('readonly', ''); }
    });
    actions.style.display = on ? 'flex' : 'none';
    editBtn.style.display = on ? 'none' : 'inline-flex';
  }

  editBtn.addEventListener('click', function() { setEditing(true); });
  if (cancelBtn) cancelBtn.addEventListener('click', function() { setEditing(false); });

  // Address management: toggle new/edit forms
  var toggleAddBtn = document.getElementById('esa-toggle-add-address');
  var newAddressForm = document.getElementById('esa-new-address-form');
  function isVisible(el) { return el && el.style.display !== 'none'; }
  if (toggleAddBtn && newAddressForm) {
    toggleAddBtn.addEventListener('click', function() {
      var open = !isVisible(newAddressForm);
      newAddressForm.style.display = open ? 'flex' : 'none';
      if (open) newAddressForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
  document.querySelectorAll('.esa-cancel-add').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (newAddressForm) newAddressForm.style.display = 'none';
    });
  });
  document.querySelectorAll('.esa-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var form = document.getElementById('esa-edit-form-' + btn.dataset.editId);
      if (!form) return;
      var open = !isVisible(form);
      form.style.display = open ? 'flex' : 'none';
      if (open) form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
  document.querySelectorAll('.esa-cancel-edit-addr').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var form = document.getElementById('esa-edit-form-' + btn.dataset.cancelId);
      if (form) form.style.display = 'none';
    });
  });
})();
</script>

<style>
.esa-dashboard {
  font-family: 'Poppins', sans-serif;
  display: flex;
  min-height: 70vh;
  background: #F7F8F9;
  color: #000;
  margin: 0;
}
.esa-sidebar {
  width: 240px;
  min-width: 240px;
  background: #0D0D0D;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  color: #fff;
}
.esa-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}
.esa-nav-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 20px;
  border-radius: 15px;
  color: #fff;
  font-weight: 500;
  font-size: 16px;
  text-decoration: none;
}
.esa-nav-item svg { width: 24px; height: 24px; }
.esa-nav-item:hover { background: #16161A; }
.esa-nav-active { background: #FEEB06; color: #000; }
.esa-nav-active:hover { background: #FEEB06; }
.esa-sidebar-help { background: #16161A; border-radius: 15px; padding: 16px; }
.esa-help-inner { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.esa-help-icon {
  width: 40px; height: 40px; background: #0D0D0D; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #FEEB06; flex-shrink: 0;
}
.esa-help-icon svg { width: 20px; height: 20px; }
.esa-help-title { color: #fff; font-weight: 500; font-size: 15px; }
.esa-help-sub { color: #ccc; font-size: 11px; }
.esa-help-btn {
  display: flex; align-items: center; justify-content: center;
  gap: 8px; background: #FEEB06; color: #000;
  padding: 12px 20px; border-radius: 15px;
  font-weight: 500; text-decoration: none; font-size: 14px;
}
.esa-help-btn svg { width: 14px; height: 14px; }

.esa-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.esa-header {
  height: 78px; flex-shrink: 0; background: #fff;
  box-shadow: 0px 3px 12px rgba(0, 0, 0, 0.05);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  gap: 12px;
}
.esa-header-back {
  display: inline-flex;
  align-items: center; justify-content: center;
  background: transparent; border: none;
  padding: 8px; cursor: pointer; color: #000;
  border-radius: 8px; text-decoration: none;
  flex-shrink: 0;
}
.esa-header-back:hover { background: #F7F8F9; }
.esa-header-back svg { width: 22px; height: 22px; }
.esa-header-logo {
  flex: 1;
  display: flex;
  justify-content: center;
}
.esa-header-logo a { display: block; text-decoration: none; }
.esa-header-user { flex-shrink: 0; }
.esa-header-logo img { height: 44px; width: auto; display: block; }
.esa-header-user { position: relative; display: flex; align-items: center; gap: 12px; }
.esa-user-btn {
  display: flex; align-items: center; gap: 12px;
  background: transparent; border: none;
  padding: 6px 8px; border-radius: 8px;
  cursor: pointer; font-family: inherit;
}
.esa-user-btn:hover { background: #F7F8F9; }
.esa-company-name { font-weight: 600; font-size: 16px; }
.esa-caret { width: 14px; height: 14px; transition: transform 0.2s; }
.esa-user-menu.is-open .esa-caret { transform: rotate(180deg); }
.esa-avatar {
  width: 42px; height: 42px; background: #FEEB06; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 20px; color: #000;
}
.esa-user-dropdown {
  position: absolute; top: 100%; right: 0; margin-top: 8px;
  background: #fff; border: 1px solid #EFF0F2;
  border-radius: 12px; box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.08);
  min-width: 200px; padding: 8px;
  display: none; z-index: 100;
}
.esa-user-menu.is-open .esa-user-dropdown { display: block; }
.esa-user-dropdown-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 8px;
  color: #000; text-decoration: none;
  font-size: 14px; font-weight: 500;
}
.esa-user-dropdown-item:hover { background: #F7F8F9; }
.esa-user-dropdown-item svg { width: 16px; height: 16px; }
.esa-user-dropdown-signout { color: #C11414; }
