{% comment %}
  main-product.liquid
  Two-column product page: left (info), right (image carousel with Glide.js)
{% endcomment %}


<div class="pdp-outer container mx-auto px-4 pt-8 max-w-7xl" data-has-custom-variant="{% if product.tags contains 'requires-custom-variant' %}true{% else %}false{% endif %}">
  <div class="product-container grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    <div class="pdp-col pdp-col--media">
      <div class="pdp-block pdp-block--media">
        {% render 'product-media-gallery' %}
      </div>
      <div class="pdp-block pdp-block--ai">
        <script
          src="https://widget.shopassistant-ai.com/preguide_ai.js"
          data-tenantid="tnt_VIostKRn5lTpaXD"
          data-app-type="pdp"
          defer
        ></script>
      </div>
      <div class="pdp-block pdp-block--faq mt-6 border-t border-grey">
        {% render 'product-faq-preview', product: product %}
      </div>
    </div>
    <!-- Product Info (Right) -->
    <div class="pdp-col pdp-col--info">
      <h1 class="pdp-block pdp-block--title text-3xl font-semibold mb-4">{{ product.title }}</h1>
      <div class="pdp-block pdp-block--sale-badge">
        {% render 'product-tags', product: product %}
      </div>
      <div class="pdp-block pdp-block--review">
        {% render 'product-review', product: product, layout:"PDP" %}
      </div>
      {% assign current_variant = product.selected_or_first_available_variant %}
      <div class="pdp-block pdp-block--sku-stock flex gap-4 items-center">
        <div id="product-sku">
          {% assign current_variant = product.selected_or_first_available_variant %}
          {% if current_variant and current_variant.sku %}
            <div class="text-sm text-gray-600 my-4">
              SKU: <span class="sku-value">{{ current_variant.sku }}</span>
            </div>
          {% endif %}
        </div>
        {% render 'product-stock-badge', product: product %}
      </div>
      <div id="product-price" class="pdp-block pdp-block--price mb-4 text-xl font-semibold">
        {% render 'product-price', product: product, show_compare_price: true, price_size: 20, show_ex_gst: true %}
      </div>

      <div class="pdp-block pdp-block--features my-6 border-gray-300 border-y-1 py-6">
        {% render 'product-features', product: product %}
      </div>

      <div class="pdp-block pdp-block--variant">
        {% render 'variant_picker' %}
      </div>

      <div class="pdp-block pdp-block--fixing">
        {% render 'product-fixing', product: product %}
      </div>
      {% assign custom_block = section.blocks | where: 'type', 'custom_field' | first %}
      {% assign product_form_id = 'product-form-' | append: product.id %}
      {% comment %} {% if product.template_suffix == 'product-with-custom-field' and custom_block %} {% endcomment %}
      {% if custom_block %}
        <div class="pdp-block pdp-block--custom">
          {% render 'product-custom-field', block: custom_block, product: product, product_form_id: product_form_id %}
        </div>
      {% endif %}

      <div class="pdp-block pdp-block--bulk">
        {% render 'bulk-discount', product: product %}
      </div>
      <div class="pdp-block pdp-block--backorder">
        {% render 'backorder-text', product: product %}
      </div>
      <div class="pdp-block pdp-block--act">
        {% render 'act-button', product: product, showPlus: true %}
      </div>

      <div class="pdp-block pdp-block--below-act">
        {% render 'product-below-act-button', product: product %}
      </div>
      <div class="pdp-block pdp-block--quotify mt-6 border-t border-grey">
        {% render 'product-quotify-button', product: product %}
      </div>

      <script>
        window.productVariants = {{ product.variants | json }};
      </script>
    </div>
  </div>
</div>

{% comment %}
  Mobile-only PDP layout: reorders the buy box above the fold on screens < 768px.
  Desktop/tablet (>= 768px) is untouched.
{% endcomment %}
<style>
  @media (max-width: 767px) {
    /* Prevent horizontal page scroll — a wide child (AI widget chips, long
       breadcrumb, iframe, etc.) must not push the body wider than the viewport. */
    html, body { overflow-x: hidden !important; max-width: 100vw !important; }
    .pdp-outer, .product-container, .pdp-col, .pdp-block {
      max-width: 100% !important;
      min-width: 0;
    }
    /* AI chip strip: scroll inside its own box instead of pushing the page wide */
    .pdp-block--ai { overflow-x: auto; -webkit-overflow-scrolling: touch; }

    /* Trim top padding above breadcrumb/image area */
    .pdp-outer { padding-top: 4px !important; padding-left: 12px !important; padding-right: 12px !important; padding-bottom: 0 !important; }

    /* Flatten two columns into one ordered flex column so children of
       both columns can be reordered together. */
    .product-container {
      display: flex !important;
      flex-direction: column !important;
      gap: 4px !important;
    }
    .pdp-col { display: contents; }

    /* Order per mobile buy-box spec */
    .pdp-block--media       { order: 1; margin-bottom: 4px; }
    .pdp-block--title       { order: 2; font-size: 22px !important; line-height: 1.25 !important; margin: 4px 0 2px !important; }
    .pdp-block--sale-badge  { order: 3; margin: 0 !important; }
    .pdp-block--review      { order: 4; display: none !important; margin: 0 !important; }
    .pdp-block--review.has-reviews { display: block !important; }
    .pdp-block--sku-stock   { order: 5; margin: 0 !important; }
    .pdp-block--price       { order: 6; margin: 2px 0 6px !important; }
    .pdp-block--variant     { order: 7; margin: 0 !important; }
    .pdp-block--fixing      { order: 8; margin: 0 !important; }
    .pdp-block--custom      { order: 9; margin: 0 !important; }
    .pdp-block--bulk        { order: 10; margin: 0 !important; }
    .pdp-block--backorder   { order: 11; margin: 0 !important; }
    .pdp-block--act         { order: 12; margin: 4px 0 !important; }
    .pdp-block--below-act   { order: 13; margin: 0 !important; }
    .pdp-block--features    { order: 14; margin: 10px 0 0 !important; padding: 10px 0 !important; border-top-width: 1px !important; border-bottom-width: 0 !important; }
    /* product-info-tabs hidden at its default position on mobile; JS moves it here */
    .product-info-tabs { display: none; }
    .pdp-block--info-tabs-mobile { order: 15; margin: 6px 0 0 !important; width: 100% !important; }
    .pdp-block--info-tabs-mobile .product-info-tabs { display: block; padding-left: 0 !important; padding-right: 0 !important; max-width: 100% !important; width: 100% !important; padding-bottom: 0 !important; }
    .pdp-block--info-tabs-mobile .product-info-tabs > .container { padding-left: 0 !important; padding-right: 0 !important; max-width: 100% !important; width: 100% !important; }
    .pdp-block--ai          { order: 16; margin: 6px 0 0 !important; }
    .pdp-block--faq         { display: none !important; }
    .pdp-block--quotify     { order: 18; margin: 6px 0 0 !important; padding: 0 !important; width: 100% !important; align-self: stretch !important; }

    /* Remove top gap on reviews section — target by partial ID since app sections don't use shopify-section- prefix */
    [id*="17684c6726"] { margin-top: 0 !important; padding-top: 0 !important; }
    [id*="17684c6726"] > * { padding-top: 0 !important; margin-top: 0 !important; }
    .m-section__heading { display: none !important; padding: 0 !important; margin: 0 !important; height: 0 !important; overflow: hidden !important; }

    /* Hide blocks that render no content so they don't contribute spacing */
    .pdp-block:empty { display: none !important; }
    .pdp-block--sale-badge:not(:has(span)) { display: none !important; }

    /* Trim gaps the price snippet adds that are too loose on mobile */
    .pdp-block--sku-stock #product-sku .text-sm { margin: 0 !important; }
    .pdp-block--sku-stock { padding: 2px 0 !important; }

    /* The pdp-main-card below-act component already has its own padding;
       pull it closer to Add to Cart. */
    .pdp-block--below-act .pdp-main-card { margin-top: 6px !important; margin-bottom: 0 !important; }

    /* The product-faq-preview snippet already has its own mb-6; override */
    .pdp-block--faq .product-faq-preview { margin-bottom: 0 !important; }

    /* ── Shorter main image: constrain the Glide slide container, not just the img.
       Glide centers content inside each .glide__slide; the parent must be the
       bounded box, otherwise the image renders small inside a tall slide. ── */
    #esProductGlide,
    #esProductGlide .glide__track,
    #esProductGlide .glide__slides,
    #esProductGlide .glide__slide {
      max-height: 215px !important;
      height: 215px !important;
    }
    #esProductGlide .glide__slide > div {
      height: 100% !important;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #esProductGlide .glide__slide img {
      max-height: 215px !important;
      height: auto !important;
      max-width: 100% !important;
      width: auto !important;
      object-fit: contain !important;
      margin: 0 auto !important;
      display: block !important;
    }

    /* Hide thumbnail strip on mobile — swipe + dots replace it */
    #esProductThumbs { display: none !important; }

    /* Overlaid pagination dots at bottom-center of the image.
       Only visible on mobile for multi-image products. */
    #esProductGlide { position: relative; }
    .pdp-mobile-dots {
      display: flex !important;
      position: absolute;
      left: 50%;
      bottom: 8px;
      transform: translateX(-50%);
      z-index: 5;
      gap: 6px;
      align-items: center;
      padding: 5px 9px;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border-radius: 999px;
      pointer-events: auto;
    }
    .pdp-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.28);
      border: 0;
      padding: 0;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .pdp-dot.pdp-dot--active,
    .pdp-dot.glide__bullet--active {
      background: rgba(0, 0, 0, 0.85);
      transform: scale(1.15);
    }

    /* Shorter breadcrumb: hide product name on mobile, keep "Home › Collection" */
    .breadcrumb-container { padding-top: 2px !important; padding-bottom: 2px !important; }
    .breadcrumb-product-name { display: none !important; }
    nav[aria-label="breadcrumbs"] .flex { flex-wrap: nowrap; overflow: hidden; }
    nav[aria-label="breadcrumbs"] .flex > a { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 70vw; }
  }

  /* Dots are mobile-only; thumb strip handles desktop */
  .pdp-mobile-dots { display: none; }
</style>

<script>
  /* On mobile, move product-info-tabs (accordion section) to between features and AI chips */
  (function () {
    function moveMobileInfoTabs() {
      if (window.innerWidth >= 768) return;
      var container = document.querySelector('.product-container');
      var infoTabsEl = document.querySelector('.product-info-tabs');
      if (!container || !infoTabsEl) return;
      var shopifySection = infoTabsEl.closest('[id^="shopify-section"]') || infoTabsEl;
      if (container.contains(shopifySection)) return;
      var wrapper = document.createElement('div');
      wrapper.className = 'pdp-block pdp-block--info-tabs-mobile';
      wrapper.appendChild(shopifySection);
      container.appendChild(wrapper);
    }
    document.addEventListener('DOMContentLoaded', moveMobileInfoTabs);
  })();

  (function () {
    /* On mobile, hide the review stars block when the reviews widget reports 0 reviews.
       The widget hydrates asynchronously, so we watch for text changes to re-check. */
    var block = document.querySelector('.pdp-block--review');
    if (!block) return;

    function updateReviewVisibility() {
      var countEl = block.querySelector('.ruk-rating-snippet-count');
      if (!countEl) return;
      var m = (countEl.textContent || '').match(/\((\d+)\)/);
      if (m && parseInt(m[1], 10) > 0) {
        block.classList.add('has-reviews');
      } else {
        block.classList.remove('has-reviews');
      }
    }

    updateReviewVisibility();
    new MutationObserver(updateReviewVisibility).observe(block, {
      subtree: true, characterData: true, childList: true
    });
  })();
</script>

{% comment %} Sticky product cart (fixed under header) {% endcomment %}
{% render 'sticky-product-cart', product: product %}
{% render 'shipping-calculator', product: product %}
{% comment %} {% render 'no-reviews-enhancer' %} — snippet missing, commented out to suppress Liquid error {% endcomment %}

{% render 'product-json-ld', product: product %}

{% assign faq = product.metafields.custom.rich_text %}

{% if faq and faq != blank %}

  {% capture faq_html %}
    {{ faq | metafield_tag }}
  {% endcapture %}

  {% assign parts = faq_html | split: '<p>' %}
  {% assign has_faq = false %}

  {% capture faq_items %}
    {% assign first = true %}

    {% for part in parts %}

      {% if part contains '<strong>' %}

        {% assign question = part
          | split: '<strong>'
          | last
          | split: '</strong>'
          | first
          | strip
        %}

        {% assign next_index = forloop.index %}
        {% assign answer_part = parts[next_index] | strip %}

        {% assign answer = answer_part
          | remove: '</p>'
          | strip_html
          | strip
        %}

        {% if question != blank and answer != blank %}
          {% assign has_faq = true %}

          {% unless first %},{% endunless %}
          {
            "@type": "Question",
            "name": {{ question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ answer | json }}
            }
          }
          {% assign first = false %}
        {% endif %}

      {% endif %}

    {% endfor %}
  {% endcapture %}

  {% if has_faq %}
    {% render 'product-faq-ld', faq_items: faq_items %}
  {% endif %}

{% endif %}
