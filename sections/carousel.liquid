{% comment %} Preload first carousel image — one hint per <source> breakpoint so the URL always matches {% endcomment %}
{% for block in section.blocks %}
  {% if block.type == 'slider_item' and block.settings.background %}
    {% assign preload_mobile = block.settings.mobile_background | default: block.settings.background %}
    <link rel="preload" as="image"
      href="{{ preload_mobile | image_url: width: 400, format: 'webp' }}"
      imagesrcset="{{ preload_mobile | image_url: width: 400, format: 'webp' }} 400w, {{ preload_mobile | image_url: width: 800, format: 'webp' }} 800w"
      imagesizes="100vw"
      media="(max-width: 640px)"
      fetchpriority="high"
    >
    <link rel="preload" as="image"
      href="{{ block.settings.background | image_url: width: 768, format: 'webp' }}"
      imagesrcset="{{ block.settings.background | image_url: width: 768, format: 'webp' }} 768w, {{ block.settings.background | image_url: width: 1536, format: 'webp' }} 1536w"
      imagesizes="100vw"
      media="(min-width: 641px) and (max-width: 1024px)"
      fetchpriority="high"
    >
    <link rel="preload" as="image"
      href="{{ block.settings.background | image_url: width: 1024, format: 'webp' }}"
      imagesrcset="{{ block.settings.background | image_url: width: 1024, format: 'webp' }} 1024w, {{ block.settings.background | image_url: width: 1920, format: 'webp' }} 1920w"
      imagesizes="100vw"
      media="(min-width: 1025px)"
      fetchpriority="high"
    >
    {% break %}
  {% endif %}
{% endfor %}

<style>
  /* Critical: give LCP image container explicit dimensions before async CSS loads */
  .hero-banner .glide__slide > div {
    position: relative;
    aspect-ratio: 1920 / 900;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero-banner .glide__slide > div {
      aspect-ratio: auto;
      height: 46vh;
      min-height: 220px;
    }
  }
  @media (min-width: 1024px) {
    .hero-banner .glide__slide > div { height: 50vh; min-height: 0; }
  }
  .hero-banner .glide__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* Show first slide immediately before Glide.js initialises (Glide adds .glide--slider on mount) */
  .hero-banner:not(.glide--slider) .glide__slide:not(:first-child) {
    display: none;
  }
  .hero-banner:not(.glide--slider) .glide__slides {
    overflow: visible;
    transform: translate3d(0, 0, 0);
  }
  .glide__bullet--active {
    background-color: transparent;
    border: 1px solid;
    height: calc(var(--spacing) * 3);
    width: calc(var(--spacing) * 3);
  }
  .carousel-content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 92%;
    max-width: 600px;
    margin-right: auto;
    margin-left: 16px;
  }
  .carousel-content-wrapper p {
    font-size: 22px;
  }
  @media (min-width: 640px) {
    .carousel-content-wrapper {
      margin-left: 20px;
    }
    .carousel-content-wrapper p {
      font-size: 34px;
    }
  }
  .carousel-content-right .carousel-content-wrapper {
    align-items: flex-end;
    margin-left: auto;
    margin-right: 120px;
  }
  .carousel-content-right .carousel-content-wrapper p {
    text-align: right;
  }
  @media (width >= 40rem) {
    .carousel-content-left .carousel-content-wrapper {
      margin-left: 120px;
    }
    .carousel-content-wrapper p {
      font-size: 42px;
    }
  }
</style>
<div class="hero-banner glide relative">
  <div class="glide__track" data-glide-el="track">
    <ul class="glide__slides">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'slider_item' %}
            <li class="glide__slide relative w-full">
              <div class="relative w-full overflow-hidden">
                {% assign img = block.settings.background %}
                {% assign mobile_img = block.settings.mobile_background | default: img %}
                {% if img %}
                  <picture>
                    <source
                      type="image/webp"
                      media="(max-width: 640px)"
                      srcset="{{ mobile_img | image_url: width: 400, format: 'webp' }} 400w, {{ mobile_img | image_url: width: 800, format: 'webp' }} 800w"
                      sizes="100vw"
                    />
                    <source
                      type="image/webp"
                      media="(max-width: 1024px)"
                      srcset="{{ img | image_url: width: 768, format: 'webp' }} 768w, {{ img | image_url: width: 1536, format: 'webp' }} 1536w"
                      sizes="100vw"
                    />
                    <source
                      type="image/webp"
                      srcset="{{ img | image_url: width: 1024, format: 'webp' }} 1024w, {{ img | image_url: width: 1920, format: 'webp' }} 1920w"
                      sizes="100vw"
                    />
                    <img
                      src="{{ img | image_url: width:1024 }}"
                      srcset="{{ img | image_url: width:1024 }} 1024w, {{ img | image_url: width:1920 }} 1920w"
                      sizes="100vw"
                      alt="{{ img.alt | escape }}"
                      loading="eager" {% if forloop.first %}fetchpriority="high"{% endif %} decoding="async"
                      class="w-full h-full object-cover object-left sm:object-center block"
                      width="1920"
                      height="900"
                    />
                  </picture>
                {% endif %}

                {% if block.settings.single_image %}
                  <a href="{{ block.settings.button_link }}" class="w-full h-full block absolute inset-0"> </a>
                {% else %}
                  <div class="w-full h-full flex carousel-content-{{ block.settings.content_position }} absolute inset-0">
                    <div class="container m-auto ">
                      <div class="carousel-content-wrapper {% if block.settings.content_position == 'right' %} ml-auto {% endif %}">
                        {% if block.settings.title != blank %}
                          <h3 class="text-xl md:text-2xl mb-4">{{ block.settings.title }}</h3>
                        {% endif %}

                        {% if block.settings.description != blank %}
                          <div class="text-2xl md:text-4xl mb-4 md:mb-6 font-semibold leading-tight">{{ block.settings.description }}</div>
                        {% endif %}

                        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                          <a href="{{ block.settings.button_link }}" class="btn primary-button">
                            {{ block.settings.button_text }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            </li>
        {% endcase %}
      {% endfor %}
    </ul>
  </div>

  {% assign block_count = section.blocks | size %}
  {% if block_count > 1 %}
    <div class="glide__arrows absolute top-1/2 w-full" data-glide-el="controls">
      <button
        class="hidden md:block glide__arrow glide__arrow--left absolute left-5 text-slate-800 cursor-pointer hover:text-slate-900 hover:scale-105 transition-all"
        data-glide-dir="<"
        aria-label="Previous slide"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-12"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </button>
      <button
        class="hidden md:block glide__arrow glide__arrow--right absolute right-5 text-slate-800 cursor-pointer hover:text-slate-900 hover:scale-105 transition-all"
        data-glide-dir=">"
        aria-label="Next slide"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-12"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>

    <div
      class="glide__bullets absolute bottom-0 flex justify-center items-center gap-2 w-full h-10"
      data-glide-el="controls[nav]"
    >
      {% assign loop_limit = block_count | minus: 1 %}
      {% for i in (0..loop_limit) %}
        <button
          class="glide__bullet bg-black w-2.5 h-2.5 rounded-full cursor-pointer transition-all hover:bg-transparent hover:border"
          data-glide-dir="={{ i }}"
          aria-label="Go to slide {{ i | plus: 1 }} of {{ block_count }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slider_item",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "background",
          "label": "Image on desktop",
          "info": "1920 x 900px recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_background",
          "label": "Image on mobile",
          "info": "588 x 350px recommended. Falls back to desktop image if not set."
        },
        {
          "type": "checkbox",
          "id": "single_image",
          "label": "Make slide fully clickable",
          "default": false
        },
        {
          "type": "header",
          "content": "Carousel Content"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },

        {
          "type": "textarea",
          "id": "title",
          "label": "Heading",
          "default": "New Collection",
          "info": "Allows custom HTML"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Tell your campaign through images</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel"
    }
  ]
}
{% endschema %}
