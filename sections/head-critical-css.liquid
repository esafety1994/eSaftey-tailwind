<style>
.hero-banner .glide__track{position:relative;aspect-ratio:1920/900;overflow:hidden}
@media(min-width:768px){.hero-banner .glide__track{aspect-ratio:auto;height:46vh;min-height:220px}}
@media(min-width:1024px){.hero-banner .glide__track{height:50vh;min-height:0}}
.hero-banner .glide__slides{position:relative;height:100%;overflow:visible;transform:none!important;transition:none!important}
.hero-banner .glide__slide{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity 500ms ease-in-out;pointer-events:none}
.hero-banner .glide__slide.glide__slide--active{opacity:1;pointer-events:auto;z-index:2}
.hero-banner .glide__slide>div{height:100%;overflow:hidden}
.hero-banner .glide__slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block}
.hero-banner:not(.glide--slider):not(.glide--carousel) .glide__arrows{display:none}
.announcement-glide:not(.glide--slider):not(.glide--carousel) .glide__slides{transition:none!important}
@media(max-width:767px){.top-bar{display:none!important}}
</style>
