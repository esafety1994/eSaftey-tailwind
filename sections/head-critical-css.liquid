<style>
/* Reset */
*,::before,::after{box-sizing:border-box;border:0 solid;margin:0;padding:0}
html{overflow-y:scroll;line-height:1.5;-webkit-text-size-adjust:100%;font-family:var(--default-font-family,system-ui,-apple-system,"Segoe UI",Roboto,Arial);-webkit-tap-highlight-color:transparent}
body{margin:0;line-height:inherit;scrollbar-gutter:stable}
img,svg,video{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:inherit}
button,[type='button'],[type='submit']{background:none;cursor:pointer;font:inherit;color:inherit}
input{font:inherit;color:inherit}
/* Layout utils used above the fold */
.hidden{display:none}
.block{display:block}
.flex{display:flex}
.grid{display:grid}
.static{position:static}
.relative{position:relative}
.absolute{position:absolute}
.sticky{position:sticky}
.inset-0{inset:0}
.top-0{top:0}
.top-full{top:100%}
.right-0{right:0}
.left-0{left:0}
.z-10{z-index:10}
.z-50{z-index:50}
.w-full{width:100%}
.w-8{width:2rem}
.w-12{width:3rem}
.w-30{width:7.5rem}
.h-auto{height:auto}
.max-w-3xl{max-width:48rem}
.flex-1{flex:1 1 0%}
.items-center{align-items:center}
.justify-between{justify-content:space-between}
.justify-center{justify-content:center}
.container{width:96%;margin:auto;max-width:100%}
.mx-auto{margin-left:auto;margin-right:auto}
.m-auto{margin:auto}
.px-2{padding-left:.5rem;padding-right:.5rem}
.px-4{padding-left:1rem;padding-right:1rem}
.px-6{padding-left:1.5rem;padding-right:1.5rem}
.py-1{padding-top:.25rem;padding-bottom:.25rem}
.py-1\.5{padding-top:.375rem;padding-bottom:.375rem}
.py-2{padding-top:.5rem;padding-bottom:.5rem}
.py-2\.5{padding-top:.625rem;padding-bottom:.625rem}
.pl-5{padding-left:1.25rem}
.pr-4{padding-right:1rem}
.gap-4{gap:1rem}
.space-y-4>*+*{margin-top:1rem}
.flex-wrap{flex-wrap:wrap}
.flex-col{flex-direction:column}
.object-contain{object-fit:contain}
.bg-white{background-color:#fff}
.bg-black{background-color:#000}
.bg-primary{background-color:#FFDC06}
.text-white{color:#fff}
.text-black{color:#000}
.text-gray-600{color:#4b5563}
.text-lg{font-size:1.125rem;line-height:1.75rem}
.text-xl{font-size:1.25rem;line-height:1.75rem}
.text-2xl{font-size:1.5rem;line-height:2rem}
.text-xs{font-size:.75rem;line-height:1rem}
.font-normal{font-weight:400}
.font-semibold{font-weight:600}
.font-bold{font-weight:700}
.rounded-full{border-radius:9999px}
.overflow-hidden{overflow:hidden}
.overflow-y-auto{overflow-y:auto}
.transition-all{transition:all .3s}
.duration-300{transition-duration:300ms}
/* Responsive */
@media(min-width:768px){
  .md\:hidden{display:none}
  .md\:block{display:block}
  .md\:flex{display:flex}
  .md\:flex-1{flex:1 1 0%}
  .md\:flex-none{flex:none}
  .md\:mx-12{margin-left:3rem;margin-right:3rem}
  .md\:w-auto{width:auto}
  .md\:py-0{padding-top:0;padding-bottom:0}
  .md\:space-x-4>*+*{margin-left:1rem}
  .md\:py-1\.5{padding-top:.375rem;padding-bottom:.375rem}
  .md\:text-2xl{font-size:1.5rem;line-height:2rem}
}
@media(min-width:1024px){
  .lg\:py-2{padding-top:.5rem;padding-bottom:.5rem}
  .lg\:min-h-12{min-height:3rem}
  .lg\:block{display:block}
  .lg\:w-48{width:12rem}
}
/* Hero banner */
.hero-banner .glide__slide>div{position:relative;width:100%;aspect-ratio:1920/900;height:auto;overflow:hidden}
.hero-banner .glide__slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;display:block}
@media(min-width:1024px){.hero-banner .glide__slide>div{aspect-ratio:auto;height:45vh}.hero-banner .glide__slide img{object-fit:cover}}
.hero-banner:not(.glide--mounted) .glide__slide:not(:first-child){display:none}
.hero-banner:not(.glide--mounted) .glide__slides{overflow:visible;transform:translate3d(0,0,0);transition:none!important}
.hero-banner:not(.glide--mounted) .glide__arrows{display:none}
.announcement-glide:not(.glide--mounted) .glide__slides{transition:none!important}
@media(max-width:767px){.top-bar{display:none!important}}
</style>
{% schema %}{"name":"Head Critical CSS","settings":[],"presets":[]}{% endschema %}
