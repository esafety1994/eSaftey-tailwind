<section class="top-collections py-6" {{ section.shopify_attributes }}>
  <div class="container mx-auto px-4">

    {% if section.settings.heading != blank %}
      <h2 class="top-collections__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="top-collections__grid">
      {% for block in section.blocks %}
        {% case block.type %}

        {%- when 'collection' -%}
          {% assign coll = collections[block.settings.collection] %}
          {% if coll %}
            {% assign tile_icon = block.settings.icon | default: coll.image %}
            <a href="{{ coll.url }}"
               class="cat-tile{% if block.settings.featured %} cat-tile--featured{% endif %}"
               {{ block.shopify_attributes }}>
              {% if tile_icon %}
                <span class="cat-tile__icon-wrap">
                  {% render 'responsive-image',
                    image: tile_icon,
                    alt: coll.title,
                    image_class: 'cat-tile__icon'
                  %}
                </span>
              {% endif %}
              <span class="cat-tile__name">{{ coll.title }}</span>
            </a>
          {% endif %}

        {%- when 'product' -%}
          {% assign product = all_products[block.settings.product] %}
          {% if product %}
            {% assign tile_icon = block.settings.image | default: product.featured_image %}
            <a href="{{ product.url }}"
               class="cat-tile{% if block.settings.featured %} cat-tile--featured{% endif %}"
               {{ block.shopify_attributes }}>
              {% if tile_icon %}
                <span class="cat-tile__icon-wrap">
                  {% render 'responsive-image',
                    image: tile_icon,
                    alt: product.title,
                    image_class: 'cat-tile__icon'
                  %}
                </span>
              {% endif %}
              <span class="cat-tile__name">{{ product.title }}</span>
            </a>
          {% endif %}

        {% endcase %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .top-collections__heading {
    font-size: 20px;
    font-weight: 800;
    color: #1a1a1a;
    margin-bottom: 14px;
  }
  @media (min-width: 768px) {
    .top-collections__heading {
      font-size: 30px;
      margin-bottom: 24px;
    }
  }

  .top-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  @media (min-width: 640px) {
    .top-collections__grid { grid-template-columns: repeat(3, 1fr); gap: 14px; }
  }
  @media (min-width: 1024px) {
    .top-collections__grid { grid-template-columns: repeat(6, 1fr); gap: 20px; }
  }

  /* ---- Tile base ---- */
  .cat-tile {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    text-decoration: none;
    color: #1a1a1a;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .cat-tile:hover,
  .cat-tile:active {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
  }

  /* ---- Featured (yellow) variant ---- */
  .cat-tile--featured {
    background: #FDDC14;
    border-color: #FDDC14;
  }

  /* ---- Icon ---- */
  .cat-tile__icon-wrap {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cat-tile__icon {
    width: 40px !important;
    height: 40px !important;
    object-fit: contain !important;
    border-radius: 0 !important;
  }

  /* ---- Label ---- */
  .cat-tile__name {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.25;
  }

  /* ---- Desktop: stack icon above text ---- */
  @media (min-width: 768px) {
    .cat-tile {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 20px 12px;
      gap: 12px;
    }
    .cat-tile__icon-wrap { width: 64px; height: 64px; }
    .cat-tile__icon { width: 64px !important; height: 64px !important; }
    .cat-tile__name { font-size: 14px; }
  }
</style>

{% schema %}
{
  "name": "Popular Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Categories"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon image (overrides collection image)"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured tile (yellow background)",
          "default": false
        }
      ]
    },
    {
      "type": "product",
      "name": "Product tile",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured tile (yellow background)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Popular Categories",
      "category": "Collections"
    }
  ]
}
{% endschema %}
